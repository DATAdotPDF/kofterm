// Detector do marcador de prompt na saida do bash.
//
// O bashrc do kofterm poe no fim do PS1 a sequencia invisivel
//   ESC ] 7770 ; <token> ; <codigo de saida> ; <uid efetivo> ; <pasta atual> BEL
// Quando ela aparece, o bash esta esperando um comando e o cursor esta no inicio da linha
// a digitar. O marcador nunca chega a tela. O uid diz se o shell e de root (sudo -i).
//
// O token e sorteado a cada inicio (so o bashrc do kofterm, numa pasta 0700, o conhece).
// Sem ele, qualquer saida (um `cat` de arquivo, uma pagina baixada) poderia imitar o
// marcador e fazer o kofterm capturar teclas que eram de outro programa, como uma senha.
// Marcador com token errado, ou longo demais, e descartado em silencio.
// Modulo puro (sem libc), testado com `kof test src/prompt.kf`.

class Feed {
    static Int EMIT = 0      // byte comum: mande para a tela
    static Int HOLD = 1      // byte engolido (parte do marcador)
    static Int MARK = 2      // marcador completo: o bash esta no prompt
    static Int FLUSH = 3     // falso alarme: mande takeHeld() e chame feed(b) de novo
}

class PromptScanner {
    List<Int> prefix = listOf(27, 93, 55, 55, 55, 48, 59) // ESC ] 7 7 7 0 ;
    List<Int> payload = listOf<Int>()
    List<Int> token = listOf<Int>()
    Int matched = 0
    Boolean inPayload = false
    Int MAX_PAYLOAD = 4096 // uma pasta muito longa ainda cabe; um "marcador" sem fim, nao

    setToken(String t) {
        token = listOf<Int>()
        var i = 0
        while (i < t.length()) {
            token.add(t.charAt(i) as Int)
            i = i + 1
        }
    }

    // Os bytes guardados num falso alarme sao sempre o comeco do prefixo, entao basta saber
    // quantos foram: nao e preciso criar uma lista a cada ESC (o top manda centenas por quadro).
    Int heldCount() {
        return heldN
    }

    Int heldAt(Int i) {
        return prefix.get(i)
    }

    Int heldN = 0

    Int feed(Int b) {
        if (inPayload) {
            if (b == 7) {
                inPayload = false
                matched = 0
                if (tokenOk()) {
                    return Feed.MARK
                }
                payload = listOf<Int>() // imitacao: descartada, nada muda
                return Feed.HOLD
            }
            if (payload.size >= MAX_PAYLOAD) {
                inPayload = false
                matched = 0
                payload = listOf<Int>()
                return Feed.HOLD
            }
            payload.add(b)
            return Feed.HOLD
        }
        if (b == prefix.get(matched)) {
            matched = matched + 1
            heldN = matched
            if (matched == prefix.size) {
                inPayload = true
                payload = listOf<Int>()
                heldN = 0
            }
            return Feed.HOLD
        }
        if (matched == 0) {
            return Feed.EMIT
        }
        matched = 0
        return Feed.FLUSH
    }

    // O primeiro campo do payload e exatamente o token.
    Boolean tokenOk() {
        if (token.size == 0 || payload.size <= token.size || payload.get(token.size) != 59) {
            return false
        }
        var i = 0
        while (i < token.size) {
            if (payload.get(i) != token.get(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // Depois de um FLUSH: os bytes guardados ja foram repassados.
    clearHeld() {
        heldN = 0
    }

    // Onde comeca o campo `n` do payload (0 = token).
    Int fieldStart(Int n) {
        var i = 0
        var seps = 0
        while (i < payload.size && seps < n) {
            if (payload.get(i) == 59) {
                seps = seps + 1
            }
            i = i + 1
        }
        return i
    }

    // Numero do campo `n`; -1 se nao houver digitos.
    Int numberField(Int n) {
        var i = fieldStart(n)
        var code = 0
        var digits = 0
        while (i < payload.size && payload.get(i) != 59) {
            var c = payload.get(i)
            if (c >= 48 && c <= 57) {
                code = code * 10 + (c - 48)
                digits = digits + 1
            }
            i = i + 1
        }
        if (digits == 0) {
            return -1
        }
        return code
    }

    // Codigo de saida do comando anterior (campo 1).
    Int status() {
        var s = numberField(1)
        if (s < 0) {
            return 0
        }
        return s
    }

    // Uid efetivo do shell (campo 2); -1 se faltar.
    Int euid() {
        return numberField(2)
    }

    // Bytes da pasta atual (o resto, depois do terceiro ';'), em UTF-8. A pasta pode ter ';'.
    List<Int> cwdBytes() {
        var out = listOf<Int>()
        var i = fieldStart(3)
        while (i < payload.size) {
            out.add(payload.get(i))
            i = i + 1
        }
        return out
    }
}

// Roda o scanner sobre uma lista e devolve o que iria para a tela (ajuda os testes).
List<Int> scanAll(PromptScanner s, List<Int> bytes, List<Int> marks) {
    var out = listOf<Int>()
    var i = 0
    while (i < bytes.size) {
        var b = bytes.get(i)
        var r = s.feed(b)
        if (r == Feed.EMIT) {
            out.add(b)
            i = i + 1
        } else if (r == Feed.MARK) {
            marks.add(s.status())
            i = i + 1
        } else if (r == Feed.FLUSH) {
            var k = 0
            while (k < s.heldCount()) {
                out.add(s.heldAt(k))
                k = k + 1
            }
            s.clearHeld()
        } else {
            i = i + 1
        }
    }
    return out
}

// Texto ASCII em bytes; "^" vira ESC e "~" vira BEL (para escrever os testes).
List<Int> pmBytes(String s) {
    var out = listOf<Int>()
    var i = 0
    while (i < s.length()) {
        var c = s.substring(i, i + 1)
        if (c == "^") {
            out.add(27)
        } else if (c == "~") {
            out.add(7)
        } else {
            out.add(s.charAt(i) as Int)
        }
        i = i + 1
    }
    return out
}

PromptScanner pmScanner() {
    var s = PromptScanner()
    s.setToken("a1b2")
    return s
}

test "marcador some da tela e traz o codigo de saida" {
    var s = pmScanner()
    var marks = listOf<Int>()
    var out = scanAll(s, pmBytes("$ ^]7770;a1b2;127;1000;/tmp~"), marks)
    assert(out.size == 2, "so o prompt visivel")
    assert(marks.size == 1 && marks.get(0) == 127, "status 127")
    assert(s.euid() == 1000, "uid 1000")
    assert(s.cwdBytes().size == 4, "cwd /tmp")
}

test "shell de root e pasta com ponto e virgula" {
    var s = pmScanner()
    var marks = listOf<Int>()
    scanAll(s, pmBytes("^]7770;a1b2;0;0;/a;b~"), marks)
    assert(s.euid() == 0, "root")
    assert(s.cwdBytes().size == 4, "cwd /a;b inteira")
}

test "outro OSC (titulo da janela) passa intacto" {
    var s = pmScanner()
    var marks = listOf<Int>()
    var out = scanAll(s, pmBytes("^]0;t~"), marks)
    assert(out.size == 6, "seis bytes devolvidos")
    assert(out.get(0) == 27 && out.get(2) == 48, "ordem preservada")
    assert(marks.size == 0, "sem marcador")
}

test "marcador cortado entre dois reads" {
    var s = pmScanner()
    var marks = listOf<Int>()
    scanAll(s, pmBytes("^]77"), marks)
    var out = scanAll(s, pmBytes("70;a1b2;0;1000;/~"), marks)
    assert(out.size == 0, "nada visivel")
    assert(marks.size == 1 && marks.get(0) == 0, "status 0")
}

test "ESC dentro de falso alarme recomeca a busca" {
    var s = pmScanner()
    var marks = listOf<Int>()
    var out = scanAll(s, pmBytes("^^]7770;a1b2;0;1000;/~"), marks)
    assert(out.size == 1 && out.get(0) == 27, "primeiro ESC devolvido")
    assert(marks.size == 1, "marcador achado")
}

test "marcador imitado (sem o token) e ignorado" {
    var s = pmScanner()
    var marks = listOf<Int>()
    // um arquivo ou pagina com o formato antigo, ou com um token chutado
    var out = scanAll(s, pmBytes("^]7770;0;1000;/tmp~^]7770;zzzz;0;0;/~^]7770;a1b;0;0;/~ok"), marks)
    assert(marks.size == 0, "nenhum prompt falso")
    assert(out.size == 2, "so o texto depois aparece")
    // e o verdadeiro continua funcionando depois
    scanAll(s, pmBytes("^]7770;a1b2;0;1000;/~"), marks)
    assert(marks.size == 1, "marcador verdadeiro aceito")
}

test "marcador sem fim nao cresce sem limite" {
    var s = pmScanner()
    var marks = listOf<Int>()
    var big = listOf<Int>()
    for (var b in pmBytes("^]7770;a1b2;")) {
        big.add(b)
    }
    var i = 0
    while (i < 5000) {
        big.add(120)
        i = i + 1
    }
    scanAll(s, big, marks)
    assert(s.payload.size <= 4096, "payload limitado")
    assert(!s.inPayload, "voltou ao normal")
    scanAll(s, pmBytes("^]7770;a1b2;0;1000;/~"), marks)
    assert(marks.size == 1, "e o proximo prompt funciona")
}
