// Detector do marcador de prompt na saida do bash.
//
// O bashrc do kofterm poe no fim do PS1 a sequencia invisivel
//   ESC ] 7770 ; <codigo de saida> ; <pasta atual> BEL
// Quando ela aparece, o bash esta esperando um comando e o cursor esta no inicio da linha
// a digitar. O marcador nunca chega a tela.
// Modulo puro (sem libc), testado com `kof test src/prompt.kf`.

class Feed {
    static Int EMIT = 0      // byte comum: mande para a tela
    static Int HOLD = 1      // byte engolido (parte do marcador)
    static Int MARK = 2      // marcador completo: o bash esta no prompt
    static Int FLUSH = 3     // falso alarme: mande takeHeld() e chame feed(b) de novo
}

class PromptScanner {
    List<Int> prefix = listOf(27, 93, 55, 55, 55, 48, 59) // ESC ] 7 7 7 0 ;
    List<Int> payload = listOf<Int>()
    Int matched = 0
    Boolean inPayload = false

    // Os bytes guardados num falso alarme sao sempre o comeco do prefixo, entao basta saber
    // quantos foram: nao e preciso criar uma lista a cada ESC (o top manda centenas por quadro).
    Int heldCount() {
        return heldN
    }

    Int heldAt(Int i) {
        return prefix.get(i)
    }

    Int heldN = 0

    Int feed(Int b) {
        if (inPayload) {
            if (b == 7) {
                inPayload = false
                matched = 0
                return Feed.MARK
            }
            payload.add(b)
            return Feed.HOLD
        }
        if (b == prefix.get(matched)) {
            matched = matched + 1
            heldN = matched
            if (matched == prefix.size) {
                inPayload = true
                payload = listOf<Int>()
                heldN = 0
            }
            return Feed.HOLD
        }
        if (matched == 0) {
            return Feed.EMIT
        }
        matched = 0
        return Feed.FLUSH
    }

    // Depois de um FLUSH: os bytes guardados ja foram repassados.
    clearHeld() {
        heldN = 0
    }

    // Codigo de saida do comando anterior (antes do primeiro ';' do payload).
    Int status() {
        var code = 0
        var i = 0
        while (i < payload.size && payload.get(i) != 59) {
            var c = payload.get(i)
            if (c >= 48 && c <= 57) {
                code = code * 10 + (c - 48)
            }
            i = i + 1
        }
        return code
    }

    // Bytes da pasta atual (depois do primeiro ';'), em UTF-8.
    List<Int> cwdBytes() {
        var out = listOf<Int>()
        var i = 0
        while (i < payload.size && payload.get(i) != 59) {
            i = i + 1
        }
        i = i + 1
        while (i < payload.size) {
            out.add(payload.get(i))
            i = i + 1
        }
        return out
    }
}

// Roda o scanner sobre uma lista e devolve o que iria para a tela (ajuda os testes).
List<Int> scanAll(PromptScanner s, List<Int> bytes, List<Int> marks) {
    var out = listOf<Int>()
    var i = 0
    while (i < bytes.size) {
        var b = bytes.get(i)
        var r = s.feed(b)
        if (r == Feed.EMIT) {
            out.add(b)
            i = i + 1
        } else if (r == Feed.MARK) {
            marks.add(s.status())
            i = i + 1
        } else if (r == Feed.FLUSH) {
            var k = 0
            while (k < s.heldCount()) {
                out.add(s.heldAt(k))
                k = k + 1
            }
            s.clearHeld()
        } else {
            i = i + 1
        }
    }
    return out
}

test "marcador some da tela e traz o codigo de saida" {
    var s = PromptScanner()
    var marks = listOf<Int>()
    // "$ " + ESC ] 7770 ; 127 ; /tmp BEL
    var out = scanAll(s, listOf(36, 32, 27, 93, 55, 55, 55, 48, 59, 49, 50, 55, 59, 47, 116, 109, 112, 7), marks)
    assert(out.size == 2, "so o prompt visivel")
    assert(marks.size == 1 && marks.get(0) == 127, "status 127")
    assert(s.cwdBytes().size == 4, "cwd /tmp")
}

test "outro OSC (titulo da janela) passa intacto" {
    var s = PromptScanner()
    var marks = listOf<Int>()
    // ESC ] 0 ; t BEL
    var out = scanAll(s, listOf(27, 93, 48, 59, 116, 7), marks)
    assert(out.size == 6, "seis bytes devolvidos")
    assert(out.get(0) == 27 && out.get(2) == 48, "ordem preservada")
    assert(marks.size == 0, "sem marcador")
}

test "marcador cortado entre dois reads" {
    var s = PromptScanner()
    var marks = listOf<Int>()
    scanAll(s, listOf(27, 93, 55, 55), marks)
    var out = scanAll(s, listOf(55, 48, 59, 48, 59, 47, 7), marks)
    assert(out.size == 0, "nada visivel")
    assert(marks.size == 1 && marks.get(0) == 0, "status 0")
}

test "ESC dentro de falso alarme recomeca a busca" {
    var s = PromptScanner()
    var marks = listOf<Int>()
    var out = scanAll(s, listOf(27, 27, 93, 55, 55, 55, 48, 59, 48, 59, 47, 7), marks)
    assert(out.size == 1 && out.get(0) == 27, "primeiro ESC devolvido")
    assert(marks.size == 1, "marcador achado")
}
