}

Int clampInt(Int v, Int lo, Int hi) {
    if (v < lo) {
        return lo
    }
    if (v > hi) {
        return hi
    }
    return v
}

// Desenho de linhas DEC (ESC ( 0), usado por programas antigos e pelo mc.
String decChar(Int cp) {
    if (cp == 106) { return "┘" }
    if (cp == 107) { return "┐" }
    if (cp == 108) { return "┌" }
    if (cp == 109) { return "└" }
    if (cp == 110) { return "┼" }
    if (cp == 113) { return "─" }
    if (cp == 116) { return "├" }
    if (cp == 117) { return "┤" }
    if (cp == 118) { return "┴" }
    if (cp == 119) { return "┬" }
    if (cp == 120) { return "│" }
    if (cp == 97) { return "▒" }
    if (cp == 96) { return "◆" }
    if (cp == 102) { return "°" }
    if (cp == 103) { return "±" }
    if (cp == 126) { return "·" }
    return "" + (cp as Char)
}

// Bytes de uma String ASCII, para os testes alimentarem o emulador.
List<Int> vtBytes(String s) {
    var out = listOf<Int>()
    var i = 0
    while (i < s.length()) {
        out.add(s.charAt(i) as Int)
        i = i + 1
    }
    return out
}

Vt vtNew(Int r, Int c) {
    var v = Vt()
    v.init(r, c)
    return v
}

test "texto, quebra de linha e retorno" {
    var v = vtNew(5, 10)
    v.feedAll(vtBytes("ola\r\nmundo"))
    assert(v.trimmed(0) == "ola", "linha 1")
    assert(v.trimmed(1) == "mundo", "linha 2")
    assert(v.cy == 1 && v.cx == 5, "cursor")
}

test "quebra automatica no fim da linha" {
    var v = vtNew(3, 4)
    v.feedAll(vtBytes("abcdef"))
    assert(v.trimmed(0) == "abcd", "primeira")
    assert(v.trimmed(1) == "ef", "continua embaixo")
}

test "rolagem quando passa da ultima linha" {
    var v = vtNew(3, 5)
    v.feedAll(vtBytes("1\r\n2\r\n3\r\n4"))
    assert(v.trimmed(0) == "2" && v.trimmed(2) == "4", "subiu uma linha")
}

test "posicao, apagar linha e tela" {
    var v = vtNew(4, 10)
    v.feedAll(vtBytes("abcdefghij"))
    v.feed(27)
    v.feedAll(vtBytes("[1;4H"))
    v.feed(27)
    v.feedAll(vtBytes("[K"))
    assert(v.trimmed(0) == "abc", "EL do cursor ao fim")
    v.feed(27)
    v.feedAll(vtBytes("[2J"))
    assert(v.trimmed(0) == "", "ED 2")
}

test "cores viram atributos normalizados e reaproveitados" {
    var v = vtNew(2, 10)
    v.feed(27)
    v.feedAll(vtBytes("[1;31mX"))
    v.feed(27)
    v.feedAll(vtBytes("[0mY"))
    assert(v.screen().get(0).at.get(0) == "1;31", "negrito vermelho")
    assert(v.screen().get(0).at.get(1) == "", "reset")
    v.feed(27)
    v.feedAll(vtBytes("[38;5;208mZ"))
    assert(v.screen().get(0).at.get(2) == "38;5;208", "256 cores")
    v.feed(27)
    v.feedAll(vtBytes("[22;31mW"))
    assert(v.screen().get(0).at.get(3) == "31", "22 desliga negrito")
    var antes = v.cacheVal.size
    v.feed(27)
    v.feedAll(vtBytes("[1;31mA"))
    v.feed(27)
    v.feedAll(vtBytes("[1;31mB"))
    assert(v.cacheVal.size == antes, "mesmo estilo nao cria String nova")
}

test "regiao de rolagem protege o resto" {
    var v = vtNew(5, 6)
    v.feedAll(vtBytes("topo"))
    v.feed(27)
    v.feedAll(vtBytes("[2;4r"))
    v.feed(27)
    v.feedAll(vtBytes("[4;1Ha\r\nb\r\nc"))
    assert(v.trimmed(0) == "topo", "fora da regiao ficou")
    assert(v.trimmed(3) == "c", "rolou dentro")
}

test "tela alternativa volta intacta (vim, htop, less)" {
    var v = vtNew(3, 10)
    v.feedAll(vtBytes("prompt$"))
    v.feed(27)
    v.feedAll(vtBytes("[?1049h"))
    v.feed(27)
    v.feedAll(vtBytes("[HVIM")) // como o vim real: posiciona antes de desenhar
    assert(v.trimmed(0) == "VIM", "na alternativa")
    v.feed(27)
    v.feedAll(vtBytes("[?1049l"))
    assert(v.trimmed(0) == "prompt$", "principal intacta")
    assert(v.cx == 7, "cursor restaurado")
}

String vtPastText(Vt v, Int i) {
    var out = ""
    for (var c in v.pastRow(i).ch) {
        out = out + c
    }
    return out.trim()
}

test "saida antiga guarda as ultimas linhas, sem a tela alternativa" {
    var v = vtNew(3, 8)
    var n = 0
    while (n < 2010) {
        v.feedAll(vtBytes("l" + n + "\r\n"))
        n = n + 1
    }
    // a tela tem 3 linhas: l2008, l2009 e a vazia do cursor; antes delas, 2008 linhas sairam
    assert(v.pastCount == 2000, "cheio no limite")
    assert(vtPastText(v, 1999) == "l2007", "a mais nova")
    assert(vtPastText(v, 0) == "l8", "a mais antiga que coube")
    assert(v.trimmed(0) == "l2008", "tela")
    v.feed(27)
    v.feedAll(vtBytes("[?1049h"))
    v.feedAll(vtBytes("a\r\nb\r\nc\r\nd\r\n"))
    v.feed(27)
    v.feedAll(vtBytes("[?1049l"))
    assert(vtPastText(v, 1999) == "l2007", "vim nao entra")
    v.resizeKeepCursor(2, 12)
    assert(vtPastText(v, 1999) == "l2008", "encolher guarda a de cima")
    v.feedAll(vtBytes("x\r\ny\r\nz\r\n"))
    assert(v.pastRow(1999).ch.size == 12, "linha nova com a largura nova")
}

test "responde a pergunta de posicao do cursor" {
    var v = vtNew(5, 10)
    v.feedAll(vtBytes("ab"))
    v.feed(27)
    v.feedAll(vtBytes("[6n"))
    var r = v.takeReply()
    assert(r.length() > 0 && r.endsWith("1;3R"), "linha 1 coluna 3")
}

test "utf8 e desenho de linhas" {
    var v = vtNew(2, 10)
    v.feedAll(listOf(195, 167, 195, 163)) // ç ã
    assert(v.trimmed(0) == "çã", "acentos")
    v.feed(27)
    v.feedAll(vtBytes("(0qx"))
    v.feed(27)
    v.feedAll(vtBytes("(B"))
    assert(v.trimmed(0) == "çã─│", "linhas DEC")
}

test "modos repassados ao terminal real" {
    var v = vtNew(2, 10)
    v.feed(27)
    v.feedAll(vtBytes("[?1h"))
    v.feed(27)
    v.feedAll(vtBytes("="))
    var h = v.takeToHost()
    assert(h.contains("[?1h") && h.endsWith("="), "DECCKM e teclado")
}

test "titulo da janela e ignorado na tela" {
    var v = vtNew(2, 20)
    v.feed(27)
    v.feedAll(vtBytes("]0;meu titulo"))
    v.feed(7)
    v.feedAll(vtBytes("x"))
    assert(v.trimmed(0) == "x", "nada do titulo na tela")
    assert(v.title == "meu titulo", "titulo guardado")
}

test "redimensionar mantem o conteudo e o cursor" {
    var v = vtNew(4, 10)
    v.feedAll(vtBytes("a\r\nb\r\nc\r\nd"))
    v.resizeKeepCursor(2, 6)
    assert(v.rows == 2 && v.cols == 6, "tamanho")
    assert(v.trimmed(1) == "d", "a linha do cursor continua visivel")
    assert(v.cy == 1, "cursor na ultima linha")
}

test "texto com emoji nunca e cortado no meio do par" {
    var s = "a😀b"
    assert(vtAt(s, 1) == "😀" && vtAt(s, 2) == "" && vtAt(s, 3) == "b", "vtAt")
    assert(vtCut(s, 2) == 1 && vtCut(s, 3) == 3 && vtCut(s, 9) == 4 && vtCut(s, 0) == 0, "vtCut")
    var v = vtNew(2, 10)
    v.putText("x😀y")
    assert(v.screen().get(0).ch.get(1) == "😀" && v.screen().get(0).ch.get(3) == "y", "putText com emoji")
    v.feedAll(vtBytes("\r\n"))
    v.putText("ok  ")
    assert(v.trimmed(1) == "ok", "trimmed")
}

test "emoji acima de U+FFFF ocupa duas colunas; acento combinante junta-se" {
    var v = vtNew(3, 8)
    // "a" + 😀 (U+1F600, F0 9F 98 80) + "b"
    v.feedAll(listOf(97, 240, 159, 152, 128, 98))
    var row = v.screen().get(0)
    assert(row.ch.get(1) == "😀" && row.ch.get(2) == "" && row.ch.get(3) == "b", "par UTF-16 e metade vazia")
    assert(v.cx == 4, "cursor andou quatro colunas")
    // "e" + U+0301 (CC 81): uma celula so
    v.feedAll(listOf(13, 10, 101, 204, 129, 120))
    var r1 = v.screen().get(1)
    assert(r1.ch.get(0) == "e" + (769 as Char) && r1.ch.get(1) == "x", "e com acento numa celula")
    assert(v.charWidth(128512) == 2 && v.charWidth(65) == 1 && v.charWidth(769) == 0 && v.charWidth(13183) == 2, "larguras")
    assert(v.charWidth(8205) == 0 && v.charWidth(65039) == 0, "ZWJ e VS16 sem largura")
    var c = v.cellsOf("a😀b", 0, 10)
    assert(c.size == 4 && c.get(1) == "😀" && c.get(2) == "" && c.get(3) == "b", "celulas da linha digitada")
    var e = v.cellsOf("😀", 9, 10)
    assert(e.size == 3 && e.get(0) == " " && e.get(1) == "😀", "largo no fim da linha vai para baixo")
}

test "caractere largo ocupa duas colunas (o ㉿ do prompt do Kali)" {
    var v = vtNew(3, 6)
    // "a" + ㉿ (U+327F, UTF-8 E3 89 BF) + "b"
    v.feedAll(listOf(97, 227, 137, 191, 98))
    var row = v.screen().get(0)
    assert(row.ch.get(0) == "a" && row.ch.get(2) == "" && row.ch.get(3) == "b", "metade vazia depois do largo")
    assert(v.cx == 4, "cursor andou tres colunas e mais uma")
    // escrever por cima da segunda metade apaga a primeira
    v.feedAll(vtBytes("\r\u001b[2Cx"))
    assert(row.ch.get(1) == " " && row.ch.get(2) == "x", "metade orfa vira espaco")
    // sem espaco no fim da linha: vai inteiro para a linha de baixo
    var w = vtNew(3, 4)
    w.feedAll(listOf(97, 98, 99, 227, 137, 191))
    assert(w.screen().get(0).ch.get(3) == " " && w.screen().get(1).ch.get(1) == "", "quebra antes do largo")
}
