// KofTerm — Fase 2: editor de linha com ghost text.
// Abre o bash (sem readline) num PTY. No prompt, o kofterm edita a linha e sugere o resto
// em cinza a partir do historico; TAB aceita. Fora do prompt, tudo passa direto.
// Restauracao segura do terminal em saida normal e nos sinais HUP/TERM (Fase 1).

class Loop {
    static Long CHUNK = 4096L
}

List<Int> toList(Long buf, Long n) {
    var out = listOf<Int>()
    var i = 0L
    while (i < n) {
        out.add(buffer.peek8(buf + i))
        i = i + 1L
    }
    return out
}

main() {
    var saved = ttySave(Sys.STDIN)
    if (saved == 0L) {
        println("kofterm: a entrada padrao nao e um terminal")
        process.exit(1)
    }
    var ws = malloc(Sys.WINSIZE_SIZE)
    winsizeGet(Sys.STDOUT, ws)

    var dir = dataDir()
    var rcPath = dir + "/bashrc"
    saveFile(rcPath, shellRc())

    // Sinais bloqueados ANTES do fork: nenhum chega no meio da preparacao.
    var sfd = sigOpen()
    if (sfd < 0) {
        println("kofterm: signalfd falhou")
        process.exit(1)
    }

    var child = ptySpawn(saved, ws, sfd, rcPath)
    if (child.pid < 0) {
        println("kofterm: forkpty falhou")
        process.exit(1)
    }

    var session = Session()
    session.master = child.master
    session.histPath = dir + "/history"
    session.loadHistory()
    var keys = KeyDecoder()
    var scanner = PromptScanner()

    ttyRaw(Sys.STDIN)
    var exitCode = -1

    // struct pollfd { int fd; short events; short revents; } x3: stdin, master, signalfd
    var fds = malloc(24L)
    var buf = malloc(Loop.CHUNK)
    var out = malloc(Loop.CHUNK * 2L)
    var info = malloc(Sys.SIGINFO_SIZE)
    try {
        buffer.poke32(fds, Sys.STDIN)
        buffer.poke32(fds + 8L, child.master)
        buffer.poke32(fds + 16L, sfd)
        var running = true
        while (running) {
            buffer.poke32(fds + 4L, Sys.POLLIN) // events=POLLIN, revents=0
            buffer.poke32(fds + 12L, Sys.POLLIN)
            buffer.poke32(fds + 20L, Sys.POLLIN)
            // timeout NULL: dorme ate ter tecla, saida do bash ou sinal
            var ready = ppoll(fds, 3L, 0L, 0L)
            if (ready > 0) {
                // saida do bash primeiro, para nao atrasar a tela
                if (buffer.peek8(fds + 14L) != 0) {
                    var n = read(child.master, buf, Loop.CHUNK)
                    if (n <= 0L) {
                        running = false // bash saiu (EIO no master)
                    } else {
                        // separa o marcador de prompt do resto da saida
                        var o = 0L
                        var i = 0L
                        while (i < n) {
                            var b = buffer.peek8(buf + i)
                            var r = scanner.feed(b)
                            if (r == Feed.EMIT) {
                                buffer.poke8(out + o, b)
                                o = o + 1L
                                i = i + 1L
                            } else if (r == Feed.FLUSH) {
                                for (var h in scanner.takeHeld()) {
                                    buffer.poke8(out + o, h)
                                    o = o + 1L
                                }
                            } else if (r == Feed.MARK) {
                                writeAll(Sys.STDOUT, out, o)
                                o = 0L
                                session.onPrompt(scanner.status(), bytesToString(scanner.cwdBytes()))
                                i = i + 1L
                            } else {
                                i = i + 1L
                            }
                        }
                        writeAll(Sys.STDOUT, out, o)
                    }
                }
                if (running && buffer.peek8(fds + 6L) != 0) {
                    var n = read(Sys.STDIN, buf, Loop.CHUNK)
                    if (n <= 0L) {
                        // terminal de fora fechou: avisa o bash como um terminal faria
                        kill(child.pid, Sys.SIGHUP)
                        running = false
                    } else if (session.editing) {
                        for (var k in keys.decode(toList(buf, n))) {
                            session.onKey(k)
                        }
                    } else {
                        writeAll(child.master, buf, n)
                    }
                }
                if (running && buffer.peek8(fds + 22L) != 0) {
                    var sig = sigRead(sfd, info)
                    if (sig == Sys.SIGWINCH) {
                        if (winsizeGet(Sys.STDOUT, ws)) {
                            winsizeSet(child.master, ws)
                        }
                    } else if (sig == Sys.SIGHUP || sig == Sys.SIGTERM) {
                        kill(child.pid, Sys.SIGHUP)
                        exitCode = 128 + sig
                        running = false
                    } else if (sig == Sys.SIGINT || sig == Sys.SIGQUIT) {
                        // vindo de fora (no modo raw o teclado nao gera sinal): repassa
                        kill(child.pid, sig)
                    }
                }
            }
        }
    } finally {
        ttyRestore(Sys.STDIN, saved)
    }

    var childCode = ptyWait(child.pid)
    if (exitCode < 0) {
        exitCode = childCode
    }
    close(child.master)
    close(sfd)
    free(info)
    free(out)
    free(buf)
    free(fds)
    free(ws)
    free(saved)
    process.exit(exitCode)
}
