// KofTerm — Fase 2: editor de linha com ghost text.
// Abre o bash (sem readline) num PTY. No prompt, o kofterm edita a linha e sugere o resto
// em cinza a partir do historico; TAB aceita. Fora do prompt, tudo passa direto.
// Restauracao segura do terminal em saida normal e nos sinais HUP/TERM (Fase 1).

class Loop {
    static Long CHUNK = 4096L
}

List<Int> toList(Long buf, Long n) {
    var out = listOf<Int>()
    var i = 0L
    while (i < n) {
        out.add(buffer.peek8(buf + i))
        i = i + 1L
    }
    return out
}

main() {
    var sub = runSubcommand(commandArgs())
    if (sub >= 0) {
        process.exit(sub)
    }
    // Um KofTerm dentro de outro (por exemplo "script -c kofterm" digitado no KofTerm) deixa a
    // coluna de fora congelada e a de dentro espremida: melhor explicar e nao abrir.
    if (secure_getenv("KOFTERM") != 0L) {
        println("O KofTerm já está aberto nesta janela: você está dentro dele.")
        var note = windowVersionNote()
        if (note.length() > 0) {
            println(note)
        }
        println("Para gravar a sessão com script, abra uma aba nova do terminal (sem o KofTerm) e rode:")
        println("  script -q -I /tmp/kt-in.log -O /tmp/kt-out.log -c kofterm")
        process.exit(0)
    }
    var saved = ttySave(Sys.STDIN)
    if (saved == 0L) {
        println("kofterm: a entrada padrao nao e um terminal")
        process.exit(1)
    }
    var ws = malloc(Sys.WINSIZE_SIZE)
    winsizeGet(Sys.STDOUT, ws)

    var dir = dataDir()
    var rcPath = dir + "/bashrc"
    // token sorteado: so o bashrc do kofterm (pasta 0700) sabe escrever o marcador de prompt
    var token = randomToken()
    if (token.length() == 0) {
        println("kofterm: nao consegui ler /dev/urandom")
        process.exit(1)
    }
    saveFile(rcPath, shellRc(dir, false, token))
    saveFile(dir + "/bashrc-login", shellRc(dir, true, token)) // para sudo -i (comeca em ~)

    // Sinais bloqueados ANTES do fork: nenhum chega no meio da preparacao.
    var sfd = sigOpen()
    if (sfd < 0) {
        println("kofterm: signalfd falhou")
        process.exit(1)
    }

    var child = ptySpawn(saved, ws, sfd, rcPath)
    if (child.pid < 0) {
        println("kofterm: forkpty falhou")
        process.exit(1)
    }

    var session = Session()
    session.master = child.master
    session.histPath = dir + "/history"
    session.loadHistory()
    session.panelPath = dir + "/panel"
    session.loadPanelSetting()
    session.tab.index.load(loadLines(findShared(dir, "index/pt_BR.txt")))
    session.recipes.load(loadLines(findShared(dir, "recipes/pt_BR.txt")))

    // o "cerebro": indice compartilhado com a aba, corpus do projeto e o que o usuario ja fez
    var brain = session.brain
    brain.index = session.tab.index
    brain.home = getenv("HOME")
    brain.eventsPath = dir + "/events"
    brain.loadKnown()
    brain.loadCorpus(loadLines(findShared(dir, "corpus/sessions.txt")))
    for (var f in listFiles(findShared(dir, "datasets/contrib"), ".kofdata")) {
        brain.loadContrib(loadLines(f))
    }
    // o arquivo de eventos também perde o que tiver cara de segredo (gravado por versões antigas)
    var allEvents = loadLines(brain.eventsPath)
    var events = listOf<String>()
    var keptEvents = ""
    for (var e in allEvents) {
        var parts = splitOn(e, "\u0009")
        if (!privateLine(parts.get(parts.size - 1))) {
            events.add(e)
            keptEvents = keptEvents + e + "\n"
        }
    }
    if (events.size != allEvents.size) {
        saveFile(brain.eventsPath, keptEvents)
    }
    if (events.size == 0) {
        // primeira vez com a Fase 4: aproveita o historico da Fase 2 (sem codigos de saida)
        var prev = ""
        for (var h in session.hist.items) {
            brain.model.observe(prev, h, "", 1)
            prev = h
        }
    }
    brain.loadEvents(events)
    var keys = KeyDecoder()
    var scanner = PromptScanner()
    scanner.setToken(token)

    ttyRaw(Sys.STDIN)
    session.start(winRows(ws), winCols(ws))
    var exitCode = -1

    // struct pollfd { int fd; short events; short revents; } x3: stdin, master, signalfd
    var fds = malloc(24L)
    var buf = malloc(Loop.CHUNK)
    var info = malloc(Sys.SIGINFO_SIZE)
    // o fim da saida do comando (ate 2 KB, em bytes crus) ajuda a sugerir "sudo ..." depois
    // de "Permissao negada"; vira String uma vez por comando, quando o prompt volta
    var tailSize = 2048L
    var tail = malloc(tailSize)
    var tailPos = 0L
    var tailLen = 0L
    try {
        buffer.poke32(fds, Sys.STDIN)
        buffer.poke32(fds + 8L, child.master)
        buffer.poke32(fds + 16L, sfd)
        var running = true
        while (running) {
            buffer.poke32(fds + 4L, Sys.POLLIN) // events=POLLIN, revents=0
            buffer.poke32(fds + 12L, Sys.POLLIN)
            buffer.poke32(fds + 20L, Sys.POLLIN)
            // sem timeout: dorme ate ter tecla, saida do bash ou sinal
            var ready = ppoll(fds, 3L, 0L, 0L)
            if (ready > 0) {
                // saida do bash primeiro, para nao atrasar a tela
                if (buffer.peek8(fds + 14L) != 0) {
                    var n = read(child.master, buf, Loop.CHUNK)
                    if (n <= 0L) {
                        running = false // bash saiu (EIO no master)
                    } else {
                        // separa o marcador de prompt; o resto vai para o emulador, na ordem
                        var vt = session.vt
                        var i = 0L
                        while (i < n) {
                            var b = buffer.peek8(buf + i)
                            var r = scanner.feed(b)
                            if (r == Feed.EMIT) {
                                vt.feed(b)
                                if (!session.editing) {
                                    buffer.poke8(tail + tailPos, b)
                                    tailPos = (tailPos + 1L) % tailSize
                                    if (tailLen < tailSize) {
                                        tailLen = tailLen + 1L
                                    }
                                }
                                i = i + 1L
                            } else if (r == Feed.FLUSH) {
                                var k = 0
                                while (k < scanner.heldCount()) {
                                    vt.feed(scanner.heldAt(k))
                                    k = k + 1
                                }
                                scanner.clearHeld()
                            } else if (r == Feed.MARK) {
                                session.brain.outputTail = ringToString(tail, tailSize, tailPos, tailLen).toLowerCase()
                                tailPos = 0L
                                tailLen = 0L
                                session.onPrompt(scanner.status(), bytesToString(scanner.cwdBytes()), scanner.euid() == 0)
                                i = i + 1L
                            } else {
                                i = i + 1L
                            }
                        }
                        session.afterOutput()
                    }
                }
                if (running && buffer.peek8(fds + 6L) != 0) {
                    var n = read(Sys.STDIN, buf, Loop.CHUNK)
                    if (n <= 0L) {
                        // terminal de fora fechou: avisa o bash como um terminal faria
                        kill(child.pid, Sys.SIGHUP)
                        running = false
                    } else if (session.editing) {
                        for (var k in keys.decode(toList(buf, n))) {
                            session.onKey(k)
                        }
                        session.flushRender()
                    } else {
                        writeAll(child.master, buf, n)
                    }
                }
                if (running && buffer.peek8(fds + 22L) != 0) {
                    var sig = sigRead(sfd, info)
                    if (sig == Sys.SIGWINCH) {
                        if (winsizeGet(Sys.STDOUT, ws)) {
                            // a sessao repassa ao bash o tamanho da area dele (sem o painel)
                            session.onResize(winRows(ws), winCols(ws))
                        }
                    } else if (sig == Sys.SIGHUP || sig == Sys.SIGTERM) {
                        kill(child.pid, Sys.SIGHUP)
                        exitCode = 128 + sig
                        running = false
                    } else if (sig == Sys.SIGINT || sig == Sys.SIGQUIT) {
                        // vindo de fora (no modo raw o teclado nao gera sinal): repassa
                        kill(child.pid, sig)
                    }
                }
            }
        }
    } finally {
        session.shutdown()
        ttyRestore(Sys.STDIN, saved)
    }

    var childCode = ptyWait(child.pid)
    if (exitCode < 0) {
        exitCode = childCode
    }
    close(child.master)
    close(sfd)
    free(info)
    free(buf)
    free(fds)
    free(ws)
    free(saved)
    process.exit(exitCode)
}
