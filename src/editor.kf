// Editor de linha: o texto que o usuario esta digitando, com cursor em caracteres.
// Modulo puro (sem libc), testado com `kof test src/editor.kf`.

class LineEditor {
    String line = ""
    Int cursor = 0

    set(String text) {
        line = text
        cursor = text.length()
    }

    clear() {
        set("")
    }

    Boolean atEnd() {
        return cursor == line.length()
    }

    // charAt devolve um numero (a posicao UTF-16), nunca corta um emoji ao meio.
    Boolean spaceAt(Int i) {
        return line.charAt(i) as Int == 32
    }

    insert(String text) {
        line = line.substring(0, cursor) + text + line.substring(cursor, line.length())
        cursor = cursor + text.length()
    }

    // Emoji acima de U+FFFF ocupa duas posicoes na String (par UTF-16): a segunda metade nunca
    // fica sozinha, entao o cursor pula as duas e apagar leva as duas.
    Boolean lowHalfAt(Int i) {
        if (i <= 0 || i >= line.length()) {
            return false
        }
        var c = line.charAt(i) as Int
        return c >= 56320 && c <= 57343
    }

    // Quantas posicoes tem o caractere que termina em `i` (exclusive) / comeca em `i`.
    Int sizeBefore(Int i) {
        if (lowHalfAt(i - 1)) {
            return 2
        }
        return 1
    }

    Int sizeAt(Int i) {
        if (lowHalfAt(i + 1)) {
            return 2
        }
        return 1
    }

    backspace() {
        if (cursor > 0) {
            var n = sizeBefore(cursor)
            line = line.substring(0, cursor - n) + line.substring(cursor, line.length())
            cursor = cursor - n
        }
    }

    deleteForward() {
        if (cursor < line.length()) {
            line = line.substring(0, cursor) + line.substring(cursor + sizeAt(cursor), line.length())
        }
    }

    left() {
        if (cursor > 0) {
            cursor = cursor - sizeBefore(cursor)
        }
    }

    right() {
        if (cursor < line.length()) {
            cursor = cursor + sizeAt(cursor)
        }
    }

    home() {
        cursor = 0
    }

    end() {
        cursor = line.length()
    }

    // Ctrl-U: apaga do inicio ate o cursor.
    killToStart() {
        line = line.substring(cursor, line.length())
        cursor = 0
    }

    // Ctrl-K: apaga do cursor ate o fim.
    killToEnd() {
        line = line.substring(0, cursor)
    }

    // Ctrl-W: apaga a palavra antes do cursor (e os espacos antes dela).
    killWordBack() {
        var start = cursor
        while (start > 0 && spaceAt(start - 1)) {
            start = start - 1
        }
        while (start > 0 && !spaceAt(start - 1)) {
            start = start - 1
        }
        line = line.substring(0, start) + line.substring(cursor, line.length())
        cursor = start
    }

    wordLeft() {
        while (cursor > 0 && spaceAt(cursor - 1)) {
            cursor = cursor - 1
        }
        while (cursor > 0 && !spaceAt(cursor - 1)) {
            cursor = cursor - 1
        }
    }

    wordRight() {
        while (cursor < line.length() && spaceAt(cursor)) {
            cursor = cursor + 1
        }
        while (cursor < line.length() && !spaceAt(cursor)) {
            cursor = cursor + 1
        }
    }
}

test "insere e apaga" {
    var e = LineEditor()
    e.insert("ls")
    e.insert(" -la")
    assert(e.line == "ls -la" && e.cursor == 6, "insercao")
    e.backspace()
    assert(e.line == "ls -l", "backspace")
}

test "insere no meio com cursor" {
    var e = LineEditor()
    e.set("sudo apt update")
    e.home()
    e.wordRight()
    e.insert(" -E")
    assert(e.line == "sudo -E apt update", "meio")
}

test "ctrl-w apaga a palavra anterior" {
    var e = LineEditor()
    e.set("git commit -m")
    e.killWordBack()
    assert(e.line == "git commit ", "ctrl-w")
}

test "ctrl-u e ctrl-k" {
    var e = LineEditor()
    e.set("echo ola mundo")
    e.home()
    e.wordRight()
    e.killToEnd()
    assert(e.line == "echo", "ctrl-k")
    e.end()
    e.killToStart()
    assert(e.line == "" && e.cursor == 0, "ctrl-u")
}

test "acentos contam como um caractere" {
    var e = LineEditor()
    e.insert("ação")
    assert(e.cursor == 4, "4 caracteres")
    e.left()
    e.deleteForward()
    assert(e.line == "açã", "delete")
}

test "emoji acima de U+FFFF anda e apaga inteiro" {
    var e = LineEditor()
    e.insert("a😀b")
    assert(e.line.length() == 4 && e.cursor == 4, "o emoji ocupa duas posicoes")
    e.left()
    assert(e.cursor == 3, "antes do b")
    e.left()
    assert(e.cursor == 1, "pulou o emoji inteiro")
    e.right()
    assert(e.cursor == 3, "e de volta")
    e.backspace()
    assert(e.line == "ab" && e.cursor == 1, "apagou o par")
    e.set("x😀")
    e.home()
    e.right()
    e.deleteForward()
    assert(e.line == "x", "delete leva o par")
    e.set("ls 😀😀 ok")
    e.killWordBack()
    e.killWordBack()
    assert(e.line == "ls ", "ctrl-w passa por emoji")
}
