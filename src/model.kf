// O "cerebro" da Fase 4: um modelo de contagens que aprende com cada comando executado.
// Modulo puro (sem libc), testado com `kof test src/model.kf`.
//
// O que ele aprende (tudo local, em memoria, reconstruido do arquivo de eventos):
// - quantas vezes cada linha foi usada e quao recente ela e;
// - qual linha costuma vir DEPOIS de qual (contexto entre linhas);
// - em que tipo de pasta cada comando e usado ("tem .git", "tem package.json"...),
//   nunca o nome da pasta;
// - qual palavra costuma vir depois de outras duas (n-gram de palavras).
// Nada aqui e mandado para fora da maquina.
//
// Por que nao Map<K,V>: no KOF 0.6.6 native, o Map nativo derruba o programa (SIGSEGV) por
// volta de 3.650 chaves; no JVM funciona. Lista e String nao tem o problema. Entao o mapa
// abaixo e feito em KOF, com baldes de listas e String.hashCode().

// Balde de um mapa: chaves e valores lado a lado.
class KtIntBucket {
    List<String> keys = listOf<String>()
    List<Int> vals = listOf<Int>()
}

class KtIntMap {
    List<KtIntBucket> buckets = listOf<KtIntBucket>()
    List<String> order = listOf<String>()
    Int size = 0

    KtIntBucket bucketFor(String key) {
        if (buckets.size == 0) {
            grow(256)
        }
        var h = key.hashCode() % buckets.size
        if (h < 0) {
            h = h + buckets.size
        }
        return buckets.get(h)
    }

    grow(Int n) {
        var old = buckets
        buckets = listOf<KtIntBucket>()
        var i = 0
        while (i < n) {
            buckets.add(KtIntBucket())
            i = i + 1
        }
        for (var b in old) {
            var j = 0
            while (j < b.keys.size) {
                var nb = bucketFor(b.keys.get(j))
                nb.keys.add(b.keys.get(j))
                nb.vals.add(b.vals.get(j))
                j = j + 1
            }
        }
    }

    Int indexIn(KtIntBucket b, String key) {
        var j = 0
        while (j < b.keys.size) {
            if (b.keys.get(j) == key) {
                return j
            }
            j = j + 1
        }
        return -1
    }

    Boolean containsKey(String key) {
        return indexIn(bucketFor(key), key) >= 0
    }

    // Valor da chave, ou 0 se nao existir.
    Int get(String key) {
        var b = bucketFor(key)
        var j = indexIn(b, key)
        if (j < 0) {
            return 0
        }
        return b.vals.get(j)
    }

    put(String key, Int value) {
        var b = bucketFor(key)
        var j = indexIn(b, key)
        if (j >= 0) {
            b.vals.set(j, value)
            return
        }
        b.keys.add(key)
        b.vals.add(value)
        order.add(key)
        size = size + 1
        if (size > buckets.size * 4) {
            grow(buckets.size * 4)
        }
    }

    List<String> keys() {
        return order
    }
}

// O mesmo mapa com valores String (guarda a String como indice numa lista).
class KtTextMap {
    KtIntMap idx = KtIntMap()
    List<String> vals = listOf<String>()

    Boolean containsKey(String key) {
        return idx.containsKey(key)
    }

    // Valor da chave, ou "" se nao existir.
    String get(String key) {
        if (!idx.containsKey(key)) {
            return ""
        }
        return vals.get(idx.get(key))
    }

    put(String key, String value) {
        if (idx.containsKey(key)) {
            vals.set(idx.get(key), value)
            return
        }
        idx.put(key, vals.size)
        vals.add(value)
    }
}

class Model {
    KtIntMap lineCount = KtIntMap()
    KtIntMap lastSeen = KtIntMap()
    KtIntMap trans = KtIntMap()
    KtIntMap featWord = KtIntMap()
    KtIntMap tokCount = KtIntMap()
    KtTextMap tokBest = KtTextMap()
    KtIntMap firstWords = KtIntMap()
    List<String> lines = listOf<String>()
    Int seq = 0

    String sep() {
        return "\u001f"
    }

    Int count(KtIntMap m, String key) {
        return m.get(key)
    }

    String text(KtTextMap m, String key) {
        return m.get(key)
    }

    bump(KtIntMap m, String key, Int by) {
        m.put(key, count(m, key) + by)
    }

    // Um comando foi executado: `prev` e a linha anterior, `feats` as caracteristicas da pasta.
    observe(String prev, String line, String feats, Int weight) {
        var l = line.trim()
        if (l.length() == 0 || l.length() > 300 || isDangerous(l)) {
            return
        }
        seq = seq + 1
        if (!lineCount.containsKey(l)) {
            lines.add(l)
        }
        bump(lineCount, l, weight)
        lastSeen.put(l, seq)
        var p = prev.trim()
        if (p.length() > 0) {
            bump(trans, p + sep() + l, weight)
        }
        var w = commandName(l)
        bump(firstWords, w, weight)
        if (feats.length() > 0) {
            for (var f in splitWords(feats, ",")) {
                bump(featWord, f + sep() + w, weight)
            }
        }
        // n-gram de palavras: (anterior2, anterior1) -> proxima, com o inicio marcado por "^"
        var toks = splitWords(l, " ")
        var a = "^"
        var b = "^"
        for (var t in toks) {
            learnToken(a + sep() + b, t, weight)
            learnToken(b, t, weight)
            a = b
            b = t
        }
    }

    learnToken(String ctx, String next, Int weight) {
        var key = ctx + sep() + sep() + next
        bump(tokCount, key, weight)
        var c = count(tokCount, key)
        if (!tokBest.containsKey(ctx) || count(tokCount, ctx + sep() + sep() + text(tokBest, ctx)) < c) {
            tokBest.put(ctx, next)
        }
    }

    Int score(String line, String prev, String feats) {
        var s = count(lineCount, line) + 3 * count(trans, prev.trim() + sep() + line)
        var w = commandName(line)
        for (var f in splitWords(feats, ",")) {
            s = s + 2 * count(featWord, f + sep() + w)
        }
        if (seq - count(lastSeen, line) < 30) {
            s = s + 2
        }
        return s
    }

    // A melhor linha completa que comeca com `prefix` (sem o prefixo), ou "".
    String completeLine(String prefix, String prev, String feats) {
        if (prefix.trim().length() == 0) {
            return ""
        }
        var best = ""
        var bestScore = -1
        for (var l in lines) {
            if (l.length() > prefix.length() && l.startsWith(prefix)) {
                var s = score(l, prev, feats)
                if (s > bestScore) {
                    best = l
                    bestScore = s
                }
            }
        }
        if (best.length() == 0) {
            return ""
        }
        return best.substring(prefix.length(), best.length())
    }

    // Linha vazia: o comando que costuma vir depois de `prev` (visto pelo menos 2 vezes).
    String nextLine(String prev, String feats) {
        var p = prev.trim()
        if (p.length() == 0) {
            return ""
        }
        var best = ""
        var bestScore = 0
        for (var l in lines) {
            var t = count(trans, p + sep() + l)
            if (t >= 2 && l != p) {
                var s = t * 10 + score(l, prev, feats)
                if (s > bestScore) {
                    best = l
                    bestScore = s
                }
            }
        }
        return best
    }

    // Proxima palavra para uma linha que termina em espaco, ou "".
    String nextToken(String line) {
        var toks = splitWords(line, " ")
        var a = "^"
        var b = "^"
        if (toks.size >= 2) {
            a = toks.get(toks.size - 2)
        }
        if (toks.size >= 1) {
            b = toks.get(toks.size - 1)
        }
        var tri = text(tokBest, a + sep() + b)
        if (tri.length() > 0) {
            return tri
        }
        if (toks.size >= 1) {
            return text(tokBest, b)
        }
        return ""
    }

    // O comando conhecido mais parecido com `word` (ate 2 letras de diferenca), ou "".
    String closestCommand(String word, List<String> extra) {
        if (word.length() < 2) {
            return ""
        }
        var best = ""
        var bestD = 3
        var bestC = -1
        var all = listOf<String>()
        for (var k in firstWords.keys()) {
            all.add(k)
        }
        for (var k in extra) {
            all.add(k)
        }
        for (var c in all) {
            if (c != word && c.length() >= 2) {
                var d = levenshtein(word, c)
                var n = count(firstWords, c)
                if (d < bestD || d == bestD && n > bestC) {
                    best = c
                    bestD = d
                    bestC = n
                }
            }
        }
        if (bestD > 2) {
            return ""
        }
        return best
    }
}

// O pacote em "apt install <pacote>" na saida de um comando, ou "". Ignora o modelo
// "apt install <deb name>" que o command-not-found mostra junto de um "voce quis dizer".
String aptInstallHint(String outputLower) {
    var at = outputLower.indexOf("apt install ")
    if (at < 0) {
        return ""
    }
    var i = at + 12
    var pkg = ""
    var stop = false
    while (i < outputLower.length() && !stop) {
        var c = outputLower.substring(i, i + 1)
        if ("abcdefghijklmnopqrstuvwxyz0123456789-.+".contains(c)) {
            pkg = pkg + c
            i = i + 1
        } else {
            stop = true
        }
    }
    if (pkg.length() < 2) {
        return ""
    }
    return pkg
}

// Correcao para a linha vazia depois de um erro: "sudo <comando>" ou o nome corrigido.
String fixLine(Model m, String prev, Int status, String outputLower, List<String> known) {
    var p = prev.trim()
    if (p.length() == 0 || status == 0) {
        return ""
    }
    if (status == 127) {
        var w = commandName(p)
        var c = m.closestCommand(w, known)
        // o command-not-found do Debian/Kali diz o pacote ("pode ser instalado com: sudo apt
        // install ufw"), mas tambem oferece pacotes de brincadeira como "gti": um erro so de
        // distancia de um comando conhecido e erro de digitacao, e a correcao vence
        var pkg = aptInstallHint(outputLower)
        if (pkg.length() > 0 && (c.length() == 0 || levenshtein(w, c) > 1)) {
            return "sudo apt install " + pkg
        }
        if (c.length() > 0) {
            var at = p.indexOf(w)
            return p.substring(0, at) + c + p.substring(at + w.length(), p.length())
        }
        // nao e erro de digitacao e o sistema nao disse o pacote: procurar pelo nome
        if (w.length() >= 3 && !w.contains("/") && !w.startsWith(".")) {
            return "apt search " + w
        }
        return ""
    }
    // "apt install claude" e o pacote nao existe com esse nome: procurar o nome certo
    if (outputLower.contains("unable to locate package") || outputLower.contains("não é possível encontrar o pacote") ||
            outputLower.contains("nao e possivel encontrar o pacote")) {
        var words = splitWords(p, " ")
        var pkg = ""
        for (var w in words) {
            if (!w.startsWith("-") && w != "sudo" && w != "apt" && w != "apt-get" && w != "install" && w != "update" && w != "&&") {
                pkg = w
            }
        }
        if (pkg.length() > 0) {
            return "apt search " + pkg
        }
    }
    if (!p.startsWith("sudo ")) {
        for (var hint in listOf("permission denied", "permissão negada", "are you root", "você é root",
                "must be root", "precisa ser root", "operation not permitted", "operação não permitida")) {
            if (outputLower.contains(hint)) {
                return "sudo " + p
            }
        }
    }
    return ""
}

// ---------- risco de um comando, pelo contexto ----------
// O risco depende do comando, dos argumentos, do privilégio (sudo, root) e da pasta atual.
// PERIGO: destrói o sistema, o disco ou a pasta pessoal; nunca é sugerido e fica em vermelho.
// ATENÇÃO: pode fazer estrago ou cortar o acesso; a coluna avisa, mas o comando pode ser sugerido.

class RiskLevel {
    static Int NONE = 0
    static Int CAUTION = 1
    static Int DANGER = 2
}

class Risk(Int level, String reason)

class RiskWords {
    // pastas do sistema: apagar ou trocar permissões delas (ou de tudo dentro) quebra a máquina
    static String SYSTEM = " /home /root /etc /usr /boot /var /bin /sbin /lib /lib32 /lib64 /opt /srv /sys /proc /dev "
    // arquivos vitais: sobrescrever ou abrir as permissões é perigo
    static String VITAL = " /etc/passwd /etc/shadow /etc/gshadow /etc/group /etc/sudoers /etc/fstab "
    static String SHELLS = " sh bash zsh dash ksh fish python python3 perl ruby "
    static String DISK = " /dev/sd /dev/nvme /dev/hd /dev/mmcblk /dev/vd /dev/xvd "
}

Boolean isDangerous(String line) {
    return lineRisk(line, false, "").level == RiskLevel.DANGER
}

// O maior risco entre todos os comandos da linha (separados por ; && || | &).
Risk lineRisk(String line, Boolean root, String cwd) {
    var compact = line.replace(" ", "")
    if (compact.contains(":(){")) {
        return Risk(RiskLevel.DANGER, "é uma \"fork bomb\": cria processos sem parar até travar a máquina.")
    }
    // "echo x>/dev/sda", sem espaço antes do >
    for (var d in splitWords(RiskWords.DISK, " ")) {
        if (compact.contains(">" + d) && !compact.contains(">>" + d)) {
            return Risk(RiskLevel.DANGER, "escreve direto num disco e apaga o que há nele.")
        }
    }
    var best = Risk(RiskLevel.NONE, "")
    var segs = riskSegments(line)
    var dir = cwd
    var i = 0
    while (i < segs.size) {
        var seg = segs.get(i)
        var words = riskWords(seg)
        // "cd /pasta && ..." muda a pasta em que os próximos comandos rodam
        if (words.size >= 2 && words.get(0) == "cd") {
            dir = words.get(1)
        }
        var r = segmentRisk(words, root, dir)
        // "curl ... | sh": roda um script baixado sem a pessoa ler
        if (i + 1 < segs.size) {
            var next = riskWords(segs.get(i + 1))
            var cmd = riskCommand(words)
            var ncmd = riskCommand(next)
            if ((cmd == "curl" || cmd == "wget") && RiskWords.SHELLS.contains(" " + ncmd + " ")) {
                r = riskMax(r, Risk(RiskLevel.CAUTION, "roda um script baixado da internet sem você ler antes. Baixe, leia e só depois execute."))
            }
        }
        best = riskMax(best, r)
        i = i + 1
    }
    return best
}

Risk riskMax(Risk a, Risk b) {
    if (b.level > a.level) {
        return b
    }
    return a
}

// Separa a linha nos operadores ; && || | & (fora de aspas).
List<String> riskSegments(String line) {
    var out = listOf<String>()
    var cur = ""
    var quote = ""
    var i = 0
    while (i < line.length()) {
        var c = line.substring(i, i + 1)
        if (quote.length() > 0) {
            if (c == quote) {
                quote = ""
            }
            cur = cur + c
        } else if (c == "'" || c == "\"") {
            quote = c
            cur = cur + c
        } else if (c == ";" || c == "|" || c == "&") {
            // "2>&1" e ">&" são redirecionamentos, não separadores
            if (c == "&" && cur.endsWith(">")) {
                cur = cur + c
            } else {
                if (cur.trim().length() > 0) {
                    out.add(cur)
                }
                cur = ""
                if (i + 1 < line.length() && line.substring(i + 1, i + 2) == c) {
                    i = i + 1
                }
            }
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    if (cur.trim().length() > 0) {
        out.add(cur)
    }
    return out
}

// Palavras do trecho, sem as aspas em volta.
List<String> riskWords(String seg) {
    var out = listOf<String>()
    for (var w in splitWords(seg.trim(), " ")) {
        var v = w
        if (v.length() >= 2 && (v.startsWith("'") && v.endsWith("'") || v.startsWith("\"") && v.endsWith("\""))) {
            v = v.substring(1, v.length() - 1)
        }
        out.add(v)
    }
    return out
}

// Índice da palavra que é o comando, pulando sudo/doas (e as opções deles), env, nohup, time,
// nice, command, exec e VAR=valor. -1 se não houver comando.
Int riskCommandIndex(List<String> w) {
    var i = 0
    while (i < w.size) {
        var t = w.get(i)
        if (t == "sudo" || t == "doas") {
            i = i + 1
            while (i < w.size && w.get(i).startsWith("-")) {
                var o = w.get(i)
                if (o == "-u" || o == "-g" || o == "-C" || o == "-D" || o == "-h" || o == "-p" || o == "-r" || o == "-t" || o == "-U") {
                    i = i + 2
                } else {
                    i = i + 1
                }
            }
        } else if (t == "env" || t == "nohup" || t == "time" || t == "command" || t == "exec") {
            i = i + 1
        } else if (t == "nice") {
            i = i + 1
            if (i < w.size && w.get(i) == "-n") {
                i = i + 2
            }
        } else if (t.contains("=") && !t.startsWith("-") && !t.startsWith("/")) {
            i = i + 1
        } else {
            return i
        }
    }
    return -1
}

String riskCommand(List<String> w) {
    var i = riskCommandIndex(w)
    if (i < 0) {
        return ""
    }
    var c = w.get(i)
    var slash = c.lastIndexOf("/")
    if (slash >= 0) {
        c = c.substring(slash + 1, c.length())
    }
    return c
}

Boolean riskPrivileged(List<String> w, Boolean root) {
    if (root) {
        return true
    }
    for (var t in w) {
        if (t == "sudo" || t == "doas") {
            return true
        }
    }
    return false
}

// Alvo sem barra no fim e com o ~ e $HOME escritos de um jeito só.
String riskNorm(String t) {
    var v = t.replace("${HOME}", "~").replace("$HOME", "~")
    while (v.length() > 1 && v.endsWith("/")) {
        v = v.substring(0, v.length() - 1)
    }
    return v
}

// O alvo apaga o sistema inteiro, uma pasta do sistema ou a pasta pessoal?
Boolean riskCritical(String target, String dir) {
    var t = riskNorm(target)
    if (t == "/" || t == "/*" || t == "~" || t == "~/*" || t == "~/.") {
        return true
    }
    if (RiskWords.SYSTEM.contains(" " + t + " ")) {
        return true
    }
    if (t.endsWith("/*") && RiskWords.SYSTEM.contains(" " + t.substring(0, t.length() - 2) + " ")) {
        return true
    }
    // "*" e "." valem a pasta atual: perigo na raiz, na pasta pessoal ou se não sabemos onde estamos
    if (t == "*" || t == "." || t == "./*" || t == ".*") {
        var d = riskNorm(dir)
        return d.length() == 0 || d == "/" || d == "~" || d == "/root" || riskIsHome(d) || RiskWords.SYSTEM.contains(" " + d + " ")
    }
    return false
}

// /home/<nome> exatamente (a pasta pessoal de alguém).
Boolean riskIsHome(String d) {
    if (!d.startsWith("/home/")) {
        return false
    }
    return !d.substring(6, d.length()).contains("/")
}

// Dentro de uma pasta do sistema (/etc/nginx, /usr/lib/x...).
Boolean riskInSystem(String target) {
    var t = riskNorm(target)
    for (var d in splitWords(RiskWords.SYSTEM, " ")) {
        if (t.startsWith(d + "/")) {
            return true
        }
    }
    return false
}

Boolean riskDisk(String target) {
    for (var d in splitWords(RiskWords.DISK, " ")) {
        if (target.startsWith(d)) {
            return true
        }
    }
    return false
}

Risk segmentRisk(List<String> w, Boolean root, String dir) {
    var none = Risk(RiskLevel.NONE, "")
    var ci = riskCommandIndex(w)
    var priv = riskPrivileged(w, root)
    // redirecionamento ">" (sobrescreve) para disco, arquivo vital ou arquivo do sistema
    var k = 0
    while (k < w.size) {
        var t = w.get(k)
        var target = ""
        if ((t == ">" || t == "1>" || t == ">|") && k + 1 < w.size) {
            target = w.get(k + 1)
        } else if (t.startsWith(">") && !t.startsWith(">>") && !t.startsWith(">&") && t.length() > 1) {
            target = t.substring(1, t.length())
        }
        if (target.length() > 0) {
            if (riskDisk(target)) {
                return Risk(RiskLevel.DANGER, "escreve direto no disco " + target + " e apaga o que há nele.")
            }
            if (RiskWords.VITAL.contains(" " + target + " ")) {
                return Risk(RiskLevel.DANGER, "apaga o conteúdo de " + target + ", um arquivo vital do sistema. Use >> para acrescentar.")
            }
            if (riskInSystem(target)) {
                none = Risk(RiskLevel.CAUTION, "sobrescreve " + target + ", um arquivo do sistema. Faça uma cópia antes.")
            }
        }
        k = k + 1
    }
    if (ci < 0) {
        return none
    }
    var cmd = riskCommand(w)
    var recursive = false
    var force = false
    var append = false
    var opts = listOf<String>()
    var targets = listOf<String>()
    var j = ci + 1
    while (j < w.size) {
        var a = w.get(j)
        if (a == "--recursive" || a == "--no-preserve-root" || a.startsWith("-") && !a.startsWith("--") && (a.contains("r") || a.contains("R"))) {
            recursive = true
        }
        if (a == "--force" || a.startsWith("-") && !a.startsWith("--") && a.contains("f")) {
            force = true
        }
        if (a == "-a" || a == "--append") {
            append = true
        }
        if (a.startsWith("-")) {
            opts.add(a)
        } else if (!a.startsWith(">") && !a.startsWith("<") && !a.startsWith("2>")) {
            targets.add(a)
        }
        j = j + 1
    }

    if (cmd == "rm" && recursive) {
        for (var t in targets) {
            if (riskCritical(t, dir)) {
                return Risk(RiskLevel.DANGER, "apaga " + riskWhat(t, dir) + " inteiro, com tudo dentro e sem lixeira.")
            }
        }
        for (var t in targets) {
            if (riskInSystem(t) && priv) {
                return Risk(RiskLevel.CAUTION, "apaga " + riskNorm(t) + " do sistema, com tudo dentro e sem lixeira. Confira o caminho duas vezes.")
            }
        }
    }
    if ((cmd == "chmod" || cmd == "chown" || cmd == "chgrp") && recursive) {
        for (var t in targets) {
            if (riskCritical(t, dir)) {
                return Risk(RiskLevel.DANGER, "muda as permissões de " + riskWhat(t, dir) + " inteiro; o sistema pode parar de funcionar.")
            }
        }
    }
    if (cmd == "chmod") {
        for (var t in targets) {
            if (RiskWords.VITAL.contains(" " + riskNorm(t) + " ")) {
                return Risk(RiskLevel.DANGER, "abre as permissões de " + riskNorm(t) + "; senhas e regras de acesso ficam expostas.")
            }
        }
    }
    if (cmd == "mv" && targets.size >= 2) {
        var s = 0
        while (s < targets.size - 1) {
            if (riskCritical(targets.get(s), dir)) {
                return Risk(RiskLevel.DANGER, "tira " + riskWhat(targets.get(s), dir) + " do lugar; o sistema para de funcionar.")
            }
            s = s + 1
        }
    }
    if (cmd.startsWith("mkfs") || cmd == "wipefs" || cmd == "mkswap" || cmd == "shred") {
        for (var t in targets) {
            if (riskDisk(t) || cmd.startsWith("mkfs")) {
                return Risk(RiskLevel.DANGER, "apaga " + t + ": tudo o que está no disco ou na partição se perde.")
            }
        }
    }
    if (cmd == "dd") {
        for (var t in targets) {
            if (t.startsWith("of=") && riskDisk(t.substring(3, t.length()))) {
                return Risk(RiskLevel.DANGER, "grava por cima do disco " + t.substring(3, t.length()) + " e apaga tudo nele.")
            }
        }
    }
    if (cmd == "fdisk" || cmd == "parted" || cmd == "gdisk" || cmd == "sfdisk" || cmd == "cfdisk") {
        for (var t in targets) {
            if (riskDisk(t)) {
                return Risk(RiskLevel.CAUTION, "altera as partições de " + t + "; um erro apaga os dados do disco.")
            }
        }
    }
    if (cmd == "find" && targets.size > 0 && riskCritical(targets.get(0), dir)) {
        for (var o in w) {
            if (o == "-delete" || o == "rm") {
                return Risk(RiskLevel.DANGER, "apaga arquivos em " + riskWhat(targets.get(0), dir) + " inteiro.")
            }
        }
    }
    if (cmd == "tee" && !append) {
        for (var t in targets) {
            if (RiskWords.VITAL.contains(" " + riskNorm(t) + " ")) {
                return Risk(RiskLevel.DANGER, "apaga o conteúdo de " + riskNorm(t) + ". Para acrescentar, use tee -a.")
            }
            if (riskInSystem(t) && priv) {
                return Risk(RiskLevel.CAUTION, "sobrescreve " + riskNorm(t) + ". Para acrescentar, use tee -a.")
            }
        }
    }
    if (cmd == "shutdown" || cmd == "reboot" || cmd == "poweroff" || cmd == "halt" ||
            cmd == "init" && targets.size > 0 && (targets.get(0) == "0" || targets.get(0) == "6") ||
            cmd == "systemctl" && targets.size > 0 && (targets.get(0) == "poweroff" || targets.get(0) == "reboot" || targets.get(0) == "halt")) {
        return Risk(RiskLevel.CAUTION, "desliga ou reinicia a máquina. Se você estiver por SSH, a conexão cai.")
    }
    if (cmd == "killall5" || cmd == "kill" && targets.size > 0 && targets.get(targets.size - 1) == "-1" || cmd == "kill" && opts.size > 0 && opts.get(opts.size - 1) == "-1") {
        return Risk(RiskLevel.CAUTION, "encerra todos os seus programas de uma vez, inclusive esta sessão.")
    }
    if (cmd == "iptables" || cmd == "ip6tables") {
        for (var o in w) {
            if (o == "-F" || o == "--flush" || o == "DROP") {
                return Risk(RiskLevel.CAUTION, "muda o firewall e pode cortar o seu acesso pela rede, inclusive por SSH.")
            }
        }
    }
    if (cmd == "nft" && w.size > ci + 1 && (w.get(ci + 1) == "flush" || w.get(ci + 1) == "delete")) {
        return Risk(RiskLevel.CAUTION, "apaga regras do firewall; a máquina pode ficar exposta ou sem acesso.")
    }
    if (cmd == "ufw" && w.size > ci + 1 && w.get(ci + 1) == "reset") {
        return Risk(RiskLevel.CAUTION, "apaga todas as regras do firewall.")
    }
    if (cmd == "crontab" && opts.size > 0 && opts.get(0) == "-r") {
        return Risk(RiskLevel.CAUTION, "apaga todas as suas tarefas agendadas, sem perguntar.")
    }
    if (cmd == "userdel" && recursive || cmd == "deluser") {
        for (var o in w) {
            if (o == "-r" || o == "--remove-home" || o == "--remove-all-files") {
                return Risk(RiskLevel.CAUTION, "apaga o usuário e a pasta pessoal dele, sem lixeira.")
            }
        }
    }
    if (cmd == "git" && w.size > ci + 1 && w.get(ci + 1) == "push" && force) {
        return Risk(RiskLevel.CAUTION, "reescreve o histórico no servidor; o trabalho de outras pessoas pode se perder.")
    }
    return none
}

// Nome amigável do alvo: "a pasta pessoal", "o sistema", "/etc"...
String riskWhat(String target, String dir) {
    var t = riskNorm(target)
    if (t == "/" || t == "/*") {
        return "o sistema"
    }
    if (t == "~" || t == "~/*" || t == "~/.") {
        return "a sua pasta pessoal"
    }
    if (t == "*" || t == "." || t == "./*" || t == ".*") {
        var d = riskNorm(dir)
        if (d.length() == 0) {
            return "a pasta atual"
        }
        return d
    }
    if (t.endsWith("/*")) {
        return t.substring(0, t.length() - 2)
    }
    return t
}

// O nome do comando (pulando sudo e VAR=valor).
String commandName(String line) {
    for (var w in splitWords(line, " ")) {
        if (w != "sudo" && !(w.contains("=") && !w.startsWith("-"))) {
            return w
        }
    }
    return ""
}

// Separa por `sep` e descarta pedacos vazios.
List<String> splitWords(String s, String sep) {
    var out = listOf<String>()
    var start = 0
    var i = 0
    while (i + sep.length() <= s.length()) {
        if (s.substring(i, i + sep.length()) == sep) {
            if (i > start) {
                out.add(s.substring(start, i))
            }
            i = i + sep.length()
            start = i
        } else {
            i = i + 1
        }
    }
    if (s.length() > start) {
        out.add(s.substring(start, s.length()))
    }
    return out
}

// Distancia de edicao em que duas letras vizinhas trocadas contam como um erro so
// (Damerau restrita): "sl" esta a 1 de "ls", como "nl"; o desempate e pelo uso.
Int levenshtein(String a, String b) {
    var prev2 = listOf<Int>()
    var prev = listOf<Int>()
    var j = 0
    while (j <= b.length()) {
        prev.add(j)
        prev2.add(j)
        j = j + 1
    }
    var i = 1
    while (i <= a.length()) {
        var cur = listOf<Int>()
        cur.add(i)
        j = 1
        while (j <= b.length()) {
            var cost = 1
            if (a.substring(i - 1, i) == b.substring(j - 1, j)) {
                cost = 0
            }
            var best = prev.get(j) + 1
            if (cur.get(j - 1) + 1 < best) {
                best = cur.get(j - 1) + 1
            }
            if (prev.get(j - 1) + cost < best) {
                best = prev.get(j - 1) + cost
            }
            if (i > 1 && j > 1 && a.substring(i - 1, i) == b.substring(j - 2, j - 1) &&
                    a.substring(i - 2, i - 1) == b.substring(j - 1, j) && prev2.get(j - 2) + 1 < best) {
                best = prev2.get(j - 2) + 1
            }
            cur.add(best)
            j = j + 1
        }
        prev2 = prev
        prev = cur
        i = i + 1
    }
    return prev.get(b.length())
}

test "aprende a sequencia e preve a proxima linha" {
    var m = Model()
    m.observe("", "sudo apt update", "", 1)
    m.observe("sudo apt update", "sudo apt upgrade", "", 1)
    m.observe("", "sudo apt update", "", 1)
    m.observe("sudo apt update", "sudo apt upgrade", "", 1)
    assert(m.nextLine("sudo apt update", "") == "sudo apt upgrade", "proxima linha")
    assert(m.nextLine("ls", "") == "", "sem contexto suficiente")
}

test "o contexto da linha anterior desempata" {
    var m = Model()
    m.observe("", "git status", "", 1)
    m.observe("", "git status", "", 1)
    m.observe("git add .", "git commit -m", "", 1)
    assert(m.completeLine("git ", "git add .", "") == "commit -m", "depois do add vem commit")
    assert(m.completeLine("git ", "ls", "") == "status", "sem o add, o mais usado")
}

test "a pasta influencia a sugestao" {
    var m = Model()
    m.observe("", "npm install", "node", 1)
    m.observe("", "make install", "make", 1)
    m.observe("", "make install", "make", 1)
    assert(m.completeLine("n", "", "node") == "pm install", "npm numa pasta node")
    assert(m.completeLine("m", "", "node") == "ake install", "make so pelo prefixo")
}

test "proxima palavra" {
    var m = Model()
    m.observe("", "git commit -m inicial", "", 1)
    m.observe("", "git commit -m outra", "", 1)
    assert(m.nextToken("git commit ") == "-m", "trigram")
    assert(m.nextToken("tar ") == "", "nada aprendido")
}

test "comandos perigosos" {
    assert(isDangerous("rm -rf /"), "rm -rf /")
    assert(isDangerous("sudo rm -rf --no-preserve-root /"), "no-preserve-root")
    assert(isDangerous("rm -fr ~"), "home")
    assert(isDangerous("sudo mkfs.ext4 /dev/sda1"), "mkfs")
    assert(isDangerous("dd if=x.iso of=/dev/sdb"), "dd")
    assert(isDangerous(":(){ :|:& };:"), "fork bomb")
    assert(isDangerous("sudo chmod -R 777 /"), "chmod /")
    assert(!isDangerous("rm -rf ./build"), "pasta local e ok")
    assert(!isDangerous("rm notas.txt"), "arquivo e ok")
    assert(!isDangerous("dd if=/dev/zero of=teste.img bs=1M count=1"), "dd para arquivo e ok")
}

test "perigo em qualquer parte da linha e escrito de outro jeito" {
    var D = RiskLevel.DANGER
    assert(lineRisk("echo ok; rm -rf /", false, "").level == D, "depois do ;")
    assert(lineRisk("cd / && rm -rf *", false, "/home/aluno/projeto").level == D, "cd / antes do *")
    assert(lineRisk("rm -rf /etc/", false, "").level == D, "barra no fim")
    assert(lineRisk("rm -rf /home/*", false, "").level == D, "tudo dentro de /home")
    assert(lineRisk("sudo -u root rm -rf /", false, "").level == D, "sudo com opcao")
    assert(lineRisk("rm -rf $HOME", false, "").level == D, "$HOME")
    assert(lineRisk("echo x > /etc/passwd", false, "").level == D, "sobrescreve arquivo vital")
    assert(lineRisk("echo x>/dev/sda", false, "").level == D, "disco sem espaco")
    assert(lineRisk("sudo chmod 777 /etc/shadow", false, "").level == D, "abre o shadow")
    assert(lineRisk("sudo mv /etc /tmp/x", false, "").level == D, "tira /etc do lugar")
    assert(lineRisk("sudo wipefs -a /dev/sdb", false, "").level == D, "wipefs")
    assert(lineRisk("sudo shred -n 1 /dev/sda", false, "").level == D, "shred no disco")
    assert(lineRisk("sudo find / -name x -delete", false, "").level == D, "find / -delete")
    assert(lineRisk("echo 1.2.3.4 x | sudo tee /etc/passwd", false, "").level == D, "tee sem -a em arquivo vital")
}

test "atencao depende do privilegio e da pasta" {
    var C = RiskLevel.CAUTION
    var N = RiskLevel.NONE
    assert(lineRisk("rm -rf /etc/nginx", false, "").level == N, "sem sudo falha sozinho")
    assert(lineRisk("sudo rm -rf /etc/nginx", false, "").level == C, "com sudo, atencao")
    assert(lineRisk("rm -rf /etc/nginx", true, "").level == C, "como root, atencao")
    assert(lineRisk("rm -rf *", false, "/home/aluno/projeto/build").level == N, "* dentro do projeto")
    assert(lineRisk("rm -rf *", false, "/home/aluno").level == RiskLevel.DANGER, "* na pasta pessoal")
    assert(lineRisk("curl -fsSL https://x.sh | sh", false, "").level == C, "curl | sh")
    assert(lineRisk("sudo reboot", false, "").level == C, "reboot")
    assert(lineRisk("sudo iptables -F", false, "").level == C, "iptables -F")
    assert(lineRisk("kill -9 -1", false, "").level == C, "kill -1")
    assert(lineRisk("crontab -r", false, "").level == C, "crontab -r")
    assert(lineRisk("git push --force", false, "").level == C, "push --force")
    assert(lineRisk("sudo fdisk /dev/sda", false, "").level == C, "fdisk")
    assert(lineRisk("echo '1.2.3.4 alvo' | sudo tee -a /etc/hosts", false, "").level == N, "tee -a e ok")
    assert(lineRisk("rm -rf build", false, "").level == N, "pasta comum")
    assert(lineRisk("ls -la 2>&1 | less", false, "").level == N, "2>&1 nao separa")
    assert(lineRisk("sudo reboot", false, "").reason.contains("SSH"), "explica o motivo")
}

test "perigoso nunca e aprendido nem sugerido" {
    var m = Model()
    m.observe("", "rm -rf /", "", 5)
    assert(m.completeLine("rm", "", "") == "", "nao sugere")
}

test "corrige sudo e nome errado" {
    var m = Model()
    m.observe("", "git status", "", 1)
    var known = listOf("ls", "cat")
    assert(fixLine(m, "apt install htop", 100, "e: não foi possível abrir... você é root?", known) == "sudo apt install htop", "sudo")
    assert(fixLine(m, "gti status", 127, "", known) == "git status", "typo")
    assert(fixLine(m, "sudo cta x", 127, "", known) == "sudo cat x", "typo com sudo")
    assert(fixLine(m, "ls", 0, "permission denied", known) == "", "sem erro, sem correcao")
}

test "pacote que nao existe sugere procurar o nome" {
    var m = Model()
    var known = listOf("ls")
    var out = "e: não é possível encontrar o pacote claude"
    assert(fixLine(m, "sudo apt update && sudo apt install -y claude", 100, out, known) == "apt search claude", "pt_BR")
    assert(fixLine(m, "sudo apt install htopp", 100, "e: unable to locate package htopp", known) == "apt search htopp", "en")
}

test "programa que falta: o command-not-found diz o pacote" {
    var m = Model()
    var known = listOf("grep", "ufw")
    var pt = "comando 'ufw' não encontrado, mas poder ser instalado com:\nsudo apt install ufw\n"
    assert(fixLine(m, "ufw status", 127, pt, known) == "sudo apt install ufw", "pt_BR")
    var en = "command 'tshark' not found, but can be installed with:\nsudo apt install tshark\n"
    assert(fixLine(m, "tshark -i eth0", 127, en, known) == "sudo apt install tshark", "en")
    var typo = "command 'grpe' not found, did you mean:\ntry: sudo apt install <deb name>\n"
    assert(fixLine(m, "grpe x", 127, typo, known) == "grep x", "modelo <deb name> nao vira pacote")
    assert(fixLine(m, "cowsay oi", 127, "cowsay: comando não encontrado", known) == "apt search cowsay", "sem pacote: procurar")
    var gti = "comando 'gti' não encontrado, mas poder ser instalado com:\nsudo apt install gti\n"
    assert(fixLine(m, "gti status", 127, gti, listOf("git")) == "git status", "erro de digitacao vence pacote de brincadeira")
    assert(fixLine(m, "./script.sh", 127, "", known) == "", "arquivo local nao vira busca")
}

test "mapa proprio aguenta 20 mil chaves (o Map nativo cai em ~3.650)" {
    var m = KtIntMap()
    var i = 0
    while (i < 20000) {
        m.put("chave" + i, i)
        i = i + 1
    }
    m.put("chave7", 70)
    assert(m.size == 20000, "tamanho")
    assert(m.get("chave19999") == 19999, "ultima")
    assert(m.get("chave7") == 70, "sobrescreve")
    assert(m.get("nao-existe") == 0, "ausente vale 0")
    assert(m.keys().size == 20000, "ordem de insercao")
    var t = KtTextMap()
    t.put("a", "x")
    t.put("a", "y")
    assert(t.get("a") == "y" && t.get("b") == "", "texto")
}

test "distancia de edicao" {
    assert(levenshtein("gti", "git") == 1, "troca de vizinhas conta 1")
    assert(levenshtein("sl", "ls") == 1, "sl")
    assert(levenshtein("grpe", "grep") == 1, "grpe")
    assert(levenshtein("cat", "cat") == 0, "igual")
    assert(levenshtein("kitten", "sitting") == 3, "classico")
}

test "sl vira ls, nao nl (desempate pelo uso)" {
    var m = Model()
    m.observe("", "ls -la", "", 0)
    m.observe("ls -la", "ls", "", 0)
    assert(fixLine(m, "sl", 127, "", listOf("nl", "ls")) == "ls", "ls e mais usado")
}
