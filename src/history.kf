// Historico de comandos e sugestao em ghost text (Fase 2: so historico).
// Na Fase 4 este modulo ganha o modelo n-gram e o contexto.
// Modulo puro (sem libc), testado com `kof test src/history.kf`.

class History {
    List<String> items = listOf<String>()
    Int browse = -1       // -1 = editando um rascunho; senao, indice em items
    String draft = ""

    // Ignora linhas vazias, repetidas em sequencia e as que comecam com espaco
    // (convencao do bash para "nao guarde isto").
    Boolean add(String cmd) {
        browse = -1
        if (cmd.trim().length() == 0 || cmd.startsWith(" ")) {
            return false
        }
        if (items.size > 0 && items.get(items.size - 1) == cmd) {
            return false
        }
        items.add(cmd)
        return true
    }

    // O resto da linha mais recente que comeca com `prefix`, ou "".
    String suggest(String prefix) {
        if (prefix.length() == 0) {
            return ""
        }
        var i = items.size - 1
        while (i >= 0) {
            var h = items.get(i)
            if (h.length() > prefix.length() && h.startsWith(prefix)) {
                return h.substring(prefix.length(), h.length())
            }
            i = i - 1
        }
        return ""
    }

    // Seta para cima: comando anterior. Guarda o rascunho na primeira vez.
    String prev(String current) {
        if (items.size == 0) {
            return current
        }
        if (browse == -1) {
            draft = current
            browse = items.size - 1
        } else if (browse > 0) {
            browse = browse - 1
        }
        return items.get(browse)
    }

    // Seta para baixo: proximo comando, ou o rascunho ao passar do fim.
    String next(String current) {
        if (browse == -1) {
            return current
        }
        if (browse < items.size - 1) {
            browse = browse + 1
            return items.get(browse)
        }
        browse = -1
        return draft
    }

    resetBrowse() {
        browse = -1
    }

    // Ctrl+R: as linhas que contem `q` (sem diferenciar maiusculas), da mais recente para a
    // mais antiga, sem repetir. Com `q` vazio, as ultimas.
    List<String> search(String q, Int max) {
        var out = listOf<String>()
        var low = q.toLowerCase()
        var i = items.size - 1
        while (i >= 0 && out.size < max) {
            var h = items.get(i)
            if ((low.length() == 0 || h.toLowerCase().contains(low)) && !hasItem(out, h)) {
                out.add(h)
            }
            i = i - 1
        }
        return out
    }

    Boolean hasItem(List<String> list, String s) {
        for (var x in list) {
            if (x == s) {
                return true
            }
        }
        return false
    }
}

// Primeira "palavra" de uma sugestao, com os espacos da frente (Ctrl+seta direita).
String firstWord(String ghost) {
    var i = 0
    while (i < ghost.length() && ghost.substring(i, i + 1) == " ") {
        i = i + 1
    }
    while (i < ghost.length() && ghost.substring(i, i + 1) != " ") {
        i = i + 1
    }
    return ghost.substring(0, i)
}

// Ordem alfabetica por byte, como o `ls` com LC_ALL=C (a lista do TAB TAB).
Boolean nameBefore(String a, String b) {
    var i = 0
    while (i < a.length() && i < b.length()) {
        var x = a.charAt(i) as Int
        var y = b.charAt(i) as Int
        if (x != y) {
            return x < y
        }
        i = i + 1
    }
    return a.length() < b.length()
}

test "nomes em ordem alfabetica" {
    assert(nameBefore("abc", "abd"), "letra")
    assert(nameBefore("ab", "abc"), "mais curto")
    assert(!nameBefore("b", "a"), "inverso")
    assert(!nameBefore("a", "a"), "igual")
}

test "sugere o mais recente com o mesmo comeco" {
    var h = History()
    h.add("sudo apt update")
    h.add("sudo apt upgrade -y")
    assert(h.suggest("sudo apt up") == "grade -y", "mais recente")
    assert(h.suggest("sudo apt upd") == "ate", "outro")
    assert(h.suggest("zzz") == "", "nada")
    assert(h.suggest("") == "", "linha vazia nao sugere")
}

test "ignora vazio, repetido e espaco na frente" {
    var h = History()
    assert(h.add("ls"), "primeiro")
    assert(!h.add("ls"), "repetido")
    assert(!h.add("   "), "vazio")
    assert(!h.add(" export TOKEN=x"), "espaco na frente")
    assert(h.items.size == 1, "so um")
}

test "setas navegam e voltam ao rascunho" {
    var h = History()
    h.add("um")
    h.add("dois")
    assert(h.prev("rasc") == "dois", "cima 1")
    assert(h.prev("dois") == "um", "cima 2")
    assert(h.prev("um") == "um", "para no primeiro")
    assert(h.next("um") == "dois", "baixo 1")
    assert(h.next("dois") == "rasc", "volta ao rascunho")
}

test "ctrl-r acha pelo meio, mais recente primeiro, sem repetir" {
    var h = History()
    h.add("ping 8.8.8.8")
    h.add("ls")
    h.add("PING -c 3 kali.org")
    h.add("ping 8.8.8.8")
    var r = h.search("ping", 10)
    assert(r.size == 2, "dois diferentes")
    assert(r.get(0) == "ping 8.8.8.8", "mais recente")
    assert(r.get(1) == "PING -c 3 kali.org", "maiusculas")
    assert(h.search("", 2).size == 2, "vazio traz os ultimos")
    assert(h.search("zzz", 5).size == 0, "nada")
}

test "primeira palavra da sugestao" {
    assert(firstWord("grade -y") == "grade", "palavra")
    assert(firstWord(" -y --fix") == " -y", "com espaco")
}
