// Sessao: liga o emulador de terminal, o editor de linha, o modelo, o indice e o bash.
//
// Desde a Fase 6 o KofTerm desenha a tela inteira ele mesmo (como o tmux): tudo o que o bash
// e os programas escrevem passa pelo emulador (vt.kf), que guarda a tela na memoria. A tela
// real fica dividida em duas colunas: a area do bash a esquerda e, com F2, o indice a direita.
// O bash e os programas recebem so o tamanho da area da esquerda (TIOCSWINSZ), entao nunca
// escrevem por cima do indice.
//
// Dois estados:
// - editing = true: o bash mostrou o prompt (marcador recebido). O KofTerm e dono da linha:
//   desenha o texto e a sugestao em cinza por cima da tela do emulador e so manda a linha
//   para o bash no Enter.
// - editing = false: um comando esta rodando (vim, sudo pedindo senha, read...).
//   Cada byte do teclado vai direto para o bash.

class Session {
    Int master = -1
    String histPath = ""
    String panelPath = ""
    LineEditor ed = LineEditor()
    History hist = History()
    IndexTab tab = IndexTab()
    Brain brain = Brain()
    Vt vt = Vt()
    RecipeBook recipes = RecipeBook()
    List<RecipeMatch> recipeHits = listOf<RecipeMatch>()
    Boolean editing = false
    String ghost = ""
    String draftAfterClear = ""
    Int lastStatus = 0
    String cwd = ""
    String feats = ""
    // o painel pergunta "esta instalado?" a cada tecla; o PATH so e consultado quando o
    // comando da linha muda (ou depois de rodar algo, que pode ter instalado o programa)
    String installedName = ""
    Boolean installedOk = true

    // Ctrl+R: o que se digita vira a busca no historico; a coluna lista o que foi achado
    Boolean searching = false
    String searchDraft = ""
    List<String> searchHits = listOf<String>()
    Int searchSel = 0
    // TAB sem sugestao e varios arquivos possiveis: a lista para escolher
    Boolean picking = false
    List<String> pickList = listOf<String>()
    String pickBase = ""
    Int pickSel = 0
    // saida antiga: quantas linhas a tela esta acima do fim (0 = no fim)
    Int view = 0
    Int pastSeen = 0
    // roda do mouse: o mouse so e capturado no prompt; F3 liga e desliga (fica gravado)
    String mousePath = ""
    Boolean mouseOn = true
    Boolean mouseCaptured = false
    String notice = ""
    String SPACE1 = " "

    // tela real
    Int rows = 24
    Int cols = 80
    Boolean panelOn = false
    List<String> lastRows = listOf<String>()
    List<String> lastPanel = listOf<String>()
    List<String> panelContent = listOf<String>()
    Boolean cursorShown = true

    // onde a linha digitada comeca (coordenadas do emulador, a partir de 0)
    Int startRow = 0
    Int startCol = 0
    // linhas cobertas pela linha digitada: primeira linha e quantidade (agora e no desenho anterior)
    Int ovStart = 0
    Int ovCount = 0
    Int prevOvStart = 0
    Int prevOvCount = 0
    List<List<String>> ovCh = listOf<List<String>>()
    List<List<String>> ovAt = listOf<List<String>>()
    List<String> colMoves = listOf<String>()

    // a tela e montada num buffer cru (malloc) com stpcpy e sai num write so: desenhar
    // nao cria Strings (o coletor do KOF native recupera so parte delas)
    Long rbuf = 0L
    Long rcap = 0L
    Long wp = 0L
    List<String> cupRows = listOf<String>()
    List<String> cupPanel = listOf<String>()
    String sgrReset = "\u001b[0m"
    String sgrOpen = "\u001b[0;"
    String sgrEnd = "m"
    String sep = "\u001b[0;90m│\u001b[0m"
    String eraseEol = "\u001b[K"
    // literais avaliados a cada quadro criariam Strings novas (KOF 0.6.6 native): ficam em campos
    String NONE = "\u0000"
    String NOTEXT = ""

    String esc() {
        return "\u001b"
    }

    String cup(Int r, Int c) {
        return esc() + "[" + r + ";" + c + "H"
    }

    // Ao abrir, tira do histórico gravado o que tiver cara de segredo (de versões antigas, que
    // ainda não filtravam) e regrava o arquivo sem essas linhas.
    loadHistory() {
        var lines = loadLines(histPath)
        var kept = ""
        var removed = 0
        for (var line in lines) {
            if (privateLine(line)) {
                removed = removed + 1
            } else {
                hist.add(line)
                kept = kept + line + "\n"
            }
        }
        if (removed > 0) {
            saveFile(histPath, kept)
        }
        hist.resetBrowse()
    }

    // Sem escolha salva (primeira vez), a coluna do indice comeca ligada: quem esta aprendendo
    // precisa ver logo o que o KofTerm faz. Depois, vale o que a pessoa escolheu com F2.
    loadPanelSetting() {
        var lines = loadLines(panelPath)
        panelOn = lines.size == 0 || lines.get(0) != "off"
    }

    // A roda do mouse comeca ligada; F3 desliga (para selecionar texto sem Shift).
    loadMouseSetting() {
        var lines = loadLines(mousePath)
        mouseOn = lines.size == 0 || lines.get(0) != "off"
    }

    toggleMouse() {
        mouseOn = !mouseOn
        if (mouseOn) {
            saveFile(mousePath, "on\n")
            notice = "F3: roda do mouse ligada. Para selecionar texto, segure Shift e arraste."
        } else {
            saveFile(mousePath, "off\n")
            notice = "F3: roda do mouse desligada. Shift+PgUp e Shift+PgDn continuam rolando."
        }
    }

    // O mouse fica com o KofTerm so no prompt (para a roda rolar a saida antiga). Rodando um
    // programa, ele volta ao terminal: vim e htop pedem o mouse deles quando querem.
    syncMouse() {
        var want = editing && mouseOn && !tab.open && !vt.altOn
        if (want != mouseCaptured) {
            mouseCaptured = want
            if (want) {
                emit(esc() + "[?1000h" + esc() + "[?1006h")
            } else {
                emit(esc() + "[?1000l" + esc() + "[?1006l")
            }
        }
    }

    // Linha de boas-vindas no topo da tela (passa pelo emulador, como se o bash a escrevesse).
    banner() {
        var s = esc() + "[90mKofTerm " + Version.NUMBER + " · TAB aceita a sugestão em cinza · F2 índice ao lado · F1 busca · " +
            "Ctrl+R histórico · roda do mouse rola (F3) · ? peça do seu jeito, ex.: ? instalar o htop" + esc() + "[0m\r\n"
        var p = strdup(s)
        var n = strlen(p)
        var i = 0L
        while (i < n) {
            vt.feed(buffer.peek8(p + i))
            i = i + 1L
        }
        free(p)
    }

    // ---------- tamanho e colunas ----------

    Int panelWidth() {
        var w = cols / 3
        if (w < 28) {
            w = 28
        }
        if (w > 48) {
            w = 48
        }
        return w
    }

    // O indice so cabe se a area do bash continuar com pelo menos 40 colunas.
    Boolean panelFits() {
        return cols - panelWidth() - 1 >= 40
    }

    Boolean panelVisible() {
        return panelOn && panelFits()
    }

    // largura da area do bash
    Int leftWidth() {
        if (panelVisible()) {
            return cols - panelWidth() - 1
        }
        return cols
    }

    // Diz ao bash o tamanho da area dele.
    applyPtySize() {
        var ws = malloc(8L)
        buffer.poke64(ws, 0L)
        buffer.poke8(ws, rows % 256)
        buffer.poke8(ws + 1L, rows / 256)
        var w = leftWidth()
        buffer.poke8(ws + 2L, w % 256)
        buffer.poke8(ws + 3L, w / 256)
        winsizeSet(master, ws)
        free(ws)
    }

    // Inicio: tela alternativa do terminal real (ao sair, a tela de antes volta) e emulador.
    start(Int r, Int c) {
        rows = r
        cols = c
        vt.init(rows, leftWidth())
        print(esc() + "[?1049h" + esc() + "[H" + esc() + "[2J")
        resetCaches()
        applyPtySize()
        banner()
    }

    resetCaches() {
        lastRows = listOf<String>()
        lastPanel = listOf<String>()
        // um valor que nenhuma linha desenhada tem: forca o primeiro desenho de tudo,
        // inclusive das linhas vazias da coluna do indice (que precisam do separador)
        cupRows = listOf<String>()
        cupPanel = listOf<String>()
        colMoves = listOf<String>()
        var c = 0
        while (c < cols) {
            colMoves.add(esc() + "[" + (c + 1) + "G") // vai para a coluna c+1 na linha atual
            c = c + 1
        }
        var i = 0
        while (i < rows) {
            lastRows.add("\u0000")
            lastPanel.add("\u0000")
            cupRows.add(cup(i + 1, 1))
            cupPanel.add(cup(i + 1, leftWidth() + 1))
            i = i + 1
        }
        vt.markAll()
        // espaco para a tela inteira com cores em toda celula, mais a coluna do indice
        var need = (rows * cols * 48 + 65536) as Long
        if (rcap < need) {
            if (rbuf != 0L) {
                free(rbuf)
            }
            rbuf = malloc(need)
            rcap = need
        }
    }

    emit(String s) {
        wp = stpcpy(wp, s)
    }

    emitRow(List<String> ch, List<String> at, Int n) {
        var cur = NONE
        var j = 0
        while (j < n && j < ch.size) {
            var a = at.get(j)
            if (a != cur) {
                if (a.length() == 0) {
                    emit(sgrReset)
                } else {
                    emit(sgrOpen)
                    emit(a)
                    emit(sgrEnd)
                }
                cur = a
            }
            emit(ch.get(j))
            j = j + 1
        }
        emit(sgrReset)
        // linha guardada quando a janela era mais estreita: completa com espacos
        while (j < n) {
            emit(SPACE1)
            j = j + 1
        }
    }

    onResize(Int r, Int c) {
        rows = r
        cols = c
        vt.resizeKeepCursor(rows, leftWidth())
        if (editing) {
            startRow = vt.cy
            startCol = vt.cx
        }
        applyPtySize()
        tab.resize(r, c)
        print(esc() + "[2J")
        resetCaches()
        if (tab.open) {
            tab.draw()
        } else {
            render()
        }
    }

    togglePanel() {
        if (!panelFits()) {
            print("\u0007") // tela estreita demais para o indice
            return
        }
        panelOn = !panelOn
        if (panelOn) {
            saveFile(panelPath, "on\n")
        } else {
            saveFile(panelPath, "off\n")
        }
        vt.resizeKeepCursor(rows, leftWidth())
        if (editing) {
            startRow = vt.cy
            startCol = vt.cx
        }
        applyPtySize()
        print(esc() + "[2J")
        resetCaches()
    }

    // ---------- saida do bash ----------

    // Um pedaco da saida do bash ja passou pelo emulador: responde perguntas do programa,
    // repassa modos ao terminal real e redesenha.
    afterOutput() {
        var reply = vt.takeReply()
        if (reply.length() > 0) {
            sendText(reply)
        }
        var host = vt.takeToHost()
        if (host.length() > 0) {
            print(host)
        }
        if (vt.titleChanged) {
            vt.titleChanged = false
            print(esc() + "]0;" + vt.title + "\u0007")
        }
        if (!tab.open) {
            render()
        }
    }

    // O bash acabou de imprimir o prompt; o cursor do emulador esta onde a linha comeca.
    onPrompt(Int status, String dir, Boolean root) {
        lastStatus = status
        cwd = dir
        recipes.asRoot = root
        brain.asRoot = root
        installedName = ""
        brain.promptReturned(status)
        feats = brain.features(dir)
        editing = true
        searching = false
        picking = false
        if (view > 0) {
            leaveView()
        }
        ed.set(draftAfterClear)
        draftAfterClear = ""
        startRow = vt.cy
        startCol = vt.cx
    }

    // ---------- desenho ----------


    // Redesenha so as linhas que mudaram. Enquanto o usuario digita, a linha e a sugestao
    // viram celulas por cima da tela do emulador; se a linha passar do fim, a tela rola.
    render() {
        var w = leftWidth()
        if (view > 0) {
            renderPast(w)
            return
        }
        prevOvStart = ovStart
        prevOvCount = ovCount
        ovCount = 0
        var curRow = vt.cy
        var curCol = vt.cx
        if (editing) {
            ghost = ""
            recipeHits = listOf<RecipeMatch>()
            if (searching) {
                searchHits = hist.search(ed.line, 200)
                searchSel = clampInt(searchSel, 0, searchHits.size - 1)
                if (searchHits.size > 0) {
                    ghost = "  → " + searchHits.get(searchSel)
                    if (!panelVisible()) {
                        ghost = ghost + "  [" + (searchSel + 1) + "/" + searchHits.size + "]"
                    }
                } else {
                    ghost = "  (nada no histórico com isso · Esc volta)"
                }
            } else if (picking) {
                var chosen = pickList.get(pickSel)
                ghost = chosen.substring(pickBase.length(), chosen.length())
            } else if (recipeMode()) {
                // "? instalar o htop": o cinza mostra o comando da receita mais parecida
                for (var m in recipes.search(recipeQuery(), 4)) {
                    if (!isDangerous(m.command)) {
                        recipeHits.add(m)
                    }
                }
                if (recipeHits.size > 0) {
                    ghost = "  → " + recipeHits.get(0).command
                } else if (recipeQuery().trim().length() > 0) {
                    ghost = "  (nenhuma receita ainda · F1 busca no índice)"
                } else {
                    ghost = "  diga o que quer fazer, ex.: instalar o htop"
                }
            } else if (ed.atEnd()) {
                ghost = brain.suggest(ed.line, cwd, feats)
            }
            if (notice.length() > 0 && !panelVisible()) {
                ghost = "  " + notice // sem a coluna, o aviso do F3 aparece na linha
            }
            var lineAttr = ""
            if (lineRisk(ed.line, recipes.asRoot, cwd).level == RiskLevel.DANGER) {
                lineAttr = "1;31" // perigoso: em vermelho
            }
            var total = startCol + ed.line.length() + ghost.length()
            var endRow = startRow
            if (total > 0) {
                endRow = startRow + (total - 1) / w
            }
            // TAB TAB sem a coluna: os candidatos em linhas embaixo da linha digitada, como o bash
            var below = pickBelow(w)
            var lineEnd = endRow
            endRow = endRow + below.size
            if (endRow > rows - 1) {
                // a linha nao cabe: rola a tela do emulador para cima
                var k = endRow - (rows - 1)
                var oldTop = vt.top
                var oldBottom = vt.bottom
                vt.top = 0
                vt.bottom = rows - 1
                vt.scrollUp(k)
                vt.top = oldTop
                vt.bottom = oldBottom
                startRow = startRow - k
                vt.cy = startRow
                endRow = rows - 1
                lineEnd = lineEnd - k
            }
            // so enquanto o usuario digita: copias das linhas cobertas
            ovCh = listOf<List<String>>()
            ovAt = listOf<List<String>>()
            ovStart = startRow
            ovCount = endRow - startRow + 1
            var r = startRow
            while (r <= endRow) {
                var rowCh = listOf<String>()
                var rowAt = listOf<String>()
                var src = vt.screen().get(r)
                var j = 0
                while (j < w) {
                    rowCh.add(src.ch.get(j))
                    rowAt.add(src.at.get(j))
                    j = j + 1
                }
                ovCh.add(rowCh)
                ovAt.add(rowAt)
                r = r + 1
            }
            // as linhas sobrepostas sao copias da tela do emulador; o texto e a sugestao vao por cima
            var i = 0
            var all = ed.line + ghost
            while (i < all.length()) {
                var at = startCol + i
                var idx = at / w
                if (idx < ovCh.size) {
                    ovCh.get(idx).set(at % w, all.substring(i, i + 1))
                    if (i < ed.line.length()) {
                        ovAt.get(idx).set(at % w, lineAttr)
                    } else {
                        ovAt.get(idx).set(at % w, "90")
                    }
                }
                i = i + 1
            }
            var b = 0
            while (b < below.size) {
                var idx = lineEnd + 1 + b - startRow
                if (idx >= 0 && idx < ovCh.size) {
                    var text = below.get(b)
                    var attr = "90"
                    if (text.startsWith("›")) {
                        attr = "7" // o escolhido
                    }
                    var j = 0
                    while (j < w) {
                        var c = SPACE1
                        if (j < text.length()) {
                            c = text.substring(j, j + 1)
                        }
                        ovCh.get(idx).set(j, c)
                        ovAt.get(idx).set(j, attr)
                        j = j + 1
                    }
                }
                b = b + 1
            }
            var pos = startCol + ed.cursor
            curRow = startRow + pos / w
            curCol = pos % w
        }
        wp = rbuf
        syncMouse()
        var r = 0
        while (r < rows) {
            var idx = -1
            if (r >= ovStart && r < ovStart + ovCount) {
                idx = r - ovStart
            }
            var wasOverlay = r >= prevOvStart && r < prevOvStart + prevOvCount
            if (idx >= 0 || wasOverlay || vt.dirty.get(r)) {
                emit(cupRows.get(r))
                if (idx >= 0) {
                    emitRow(ovCh.get(idx), ovAt.get(idx), w)
                } else {
                    var src = vt.screen().get(r)
                    emitRow(src.ch, src.at, w)
                }
                vt.dirty.set(r, false)
            }
            r = r + 1
        }
        if (panelVisible()) {
            panelDraw()
        }
        // cursor: linha e coluna com Strings prontas (sem criar nenhuma a cada quadro)
        emit(cupRows.get(clampInt(curRow, 0, rows - 1)))
        emit(colMoves.get(clampInt(curCol, 0, colMoves.size - 1)))
        var show = editing || vt.cursorVisible
        if (show != cursorShown) {
            cursorShown = show
            if (show) {
                emit(esc() + "[?25h")
            } else {
                emit(esc() + "[?25l")
            }
        }
        writeAll(Sys.STDOUT, rbuf, wp - rbuf)
    }

    // ---------- modo humanizado (receitas) ----------

    Boolean recipeMode() {
        return !searching && ed.line.startsWith("?")
    }

    // ---------- Ctrl+R, TAB TAB e saida antiga ----------

    // Ctrl+R: o que ja estava digitado vira a busca; Esc devolve a linha como estava.
    startSearch() {
        searching = true
        picking = false
        searchDraft = ed.line
        searchSel = 0
    }

    endSearch(Boolean use) {
        searching = false
        if (use && searchSel >= 0 && searchSel < searchHits.size) {
            ed.set(searchHits.get(searchSel)) // na linha, sem rodar
        } else {
            ed.set(searchDraft)
        }
        hist.resetBrowse()
    }

    // O ultimo pedaco da linha (depois do ultimo espaco): o caminho que o TAB completa.
    String lastToken() {
        var i = ed.line.length()
        while (i > 0 && ed.line.substring(i - 1, i) != " ") {
            i = i - 1
        }
        return ed.line.substring(i, ed.line.length())
    }

    // TAB sem sugestao: se o nome pode ser mais de um arquivo, abre a lista para escolher.
    Boolean startPick() {
        if (!ed.atEnd() || ed.line.trim().length() == 0) {
            return false
        }
        var tok = lastToken()
        var list = brain.pathCandidates(cwd, tok)
        if (list.size < 2) {
            return false
        }
        pickList = list
        pickBase = brain.pathBase(tok)
        pickSel = 0
        picking = true
        return true
    }

    // Sem a coluna: ate 4 candidatos embaixo da linha ("›" marca o escolhido).
    List<String> pickBelow(Int w) {
        var out = listOf<String>()
        if (!picking || panelVisible()) {
            return out
        }
        var first = clampInt(pickSel - 1, 0, maxZero(pickList.size - 4))
        var i = first
        while (i < pickList.size && i < first + 4) {
            var mark = "  "
            if (i == pickSel) {
                mark = "› "
            }
            var line = mark + pickList.get(i)
            if (i == first + 3 && pickList.size > first + 4) {
                line = line + "   (+" + (pickList.size - first - 4) + ")"
            }
            out.add(clip(line, w - 1))
            i = i + 1
        }
        return out
    }

    Int maxZero(Int v) {
        if (v < 0) {
            return 0
        }
        return v
    }

    List<String> searchPanel(Int w) {
        var out = listOf<String>()
        out.add(esc() + "[7m" + pad(clip(" Histórico · ↑↓ escolhe · Enter usa · Esc sai", w), w) + esc() + "[0m")
        out.add("")
        if (searchHits.size == 0) {
            for (var t in wrapText("Nada no histórico tem \"" + ed.line + "\". Apague uma letra ou Esc para voltar.", w - 1)) {
                out.add(" " + esc() + "[90m" + t + esc() + "[0m")
            }
            return out
        }
        // a janela de itens acompanha o escolhido
        var room = rows - 5
        var first = clampInt(searchSel - room / 2, 0, maxZero(searchHits.size - room))
        var i = first
        while (i < searchHits.size && i < first + room) {
            var h = clip(searchHits.get(i), w - 2)
            if (i == searchSel) {
                out.add(" " + esc() + "[7m" + pad(h, w - 2) + esc() + "[0m")
            } else if (lineRisk(h, recipes.asRoot, cwd).level == RiskLevel.DANGER) {
                out.add(" " + esc() + "[31m" + h + esc() + "[0m")
            } else {
                out.add(" " + h)
            }
            i = i + 1
        }
        out.add("")
        for (var t in wrapText("Enter coloca na linha, sem rodar. " + (searchSel + 1) + " de " + searchHits.size + ".", w - 1)) {
            out.add(" " + esc() + "[90m" + t + esc() + "[0m")
        }
        return out
    }

    List<String> pickPanel(Int w) {
        var out = listOf<String>()
        out.add(esc() + "[7m" + pad(clip(" Arquivos · TAB próximo · Enter usa · Esc sai", w), w) + esc() + "[0m")
        out.add("")
        var room = rows - 5
        var first = clampInt(pickSel - room / 2, 0, maxZero(pickList.size - room))
        var i = first
        while (i < pickList.size && i < first + room) {
            var name = clip(pickList.get(i), w - 2)
            if (i == pickSel) {
                out.add(" " + esc() + "[7m" + pad(name, w - 2) + esc() + "[0m")
            } else if (name.endsWith("/")) {
                out.add(" " + esc() + "[34m" + name + esc() + "[0m")
            } else {
                out.add(" " + name)
            }
            i = i + 1
        }
        if (pickList.size > first + room) {
            out.add(" " + esc() + "[90m+" + (pickList.size - first - room) + " abaixo" + esc() + "[0m")
        }
        out.add("")
        for (var t in wrapText(pickList.size + " nomes começam assim. Pastas terminam em / e estão em azul.", w - 1)) {
            out.add(" " + esc() + "[90m" + t + esc() + "[0m")
        }
        return out
    }

    // Roda ou Shift+PgUp: sobe `n` linhas na saida antiga (negativo desce).
    scrollView(Int n) {
        var v = clampInt(view + n, 0, vt.pastCount + 1)
        if (v == view) {
            return
        }
        if (v == 0) {
            leaveView()
            return
        }
        if (view == 0) {
            pastSeen = vt.pastTotal
        }
        view = v
    }

    // De volta ao fim: a tela inteira precisa ser redesenhada (a linha digitada tambem).
    leaveView() {
        view = 0
        vt.markAll()
        prevOvStart = 0
        prevOvCount = rows
        resetPanelCache()
    }

    resetPanelCache() {
        var i = 0
        while (i < rows) {
            lastPanel.set(i, NONE)
            i = i + 1
        }
    }

    // A tela olhando para cima: linhas da saida antiga e da tela, com uma faixa no topo.
    renderPast(Int w) {
        // saida nova (um programa em segundo plano) nao puxa a tela: a vista sobe junto
        if (vt.pastTotal != pastSeen) {
            view = clampInt(view + vt.pastTotal - pastSeen, 1, vt.pastCount + 1)
            pastSeen = vt.pastTotal
        }
        wp = rbuf
        syncMouse()
        var r = 0
        while (r < rows) {
            emit(cupRows.get(r))
            if (r == 0) {
                emit(esc() + "[7m" + pad(clip(" ↑ " + view + " linhas acima · role para baixo ou digite para voltar", w), w) + esc() + "[0m")
            } else {
                var g = vt.pastCount - view + r
                if (g < 0) {
                    emitRow(listOf<String>(), listOf<String>(), w)
                } else if (g < vt.pastCount) {
                    var row = vt.pastRow(g)
                    emitRow(row.ch, row.at, w)
                } else {
                    var row = vt.screen().get(g - vt.pastCount)
                    emitRow(row.ch, row.at, w)
                }
            }
            r = r + 1
        }
        if (panelVisible()) {
            panelDraw()
        }
        if (cursorShown) {
            cursorShown = false
            emit(esc() + "[?25l")
        }
        writeAll(Sys.STDOUT, rbuf, wp - rbuf)
    }

    String recipeQuery() {
        return ed.line.substring(1, ed.line.length())
    }

    // TAB, seta ou Enter no modo humanizado: o comando vai para a linha, para o usuario ler
    // (e explicar com F2) antes de rodar. Nada roda sozinho.
    Boolean acceptRecipe() {
        if (recipeHits.size == 0) {
            print("\u0007")
            return false
        }
        ed.set(recipeHits.get(0).command)
        hist.resetBrowse()
        return true
    }

    List<String> recipePanel(Int w) {
        var out = listOf<String>()
        out.add(esc() + "[7m" + pad(clip(" Receitas · TAB usa · F2 fecha", w), w) + esc() + "[0m")
        out.add("")
        if (recipeHits.size == 0) {
            for (var t in wrapText("Escreva depois do ? o que você quer fazer, do seu jeito. Exemplos:", w - 1)) {
                out.add(" " + t)
            }
            for (var ex in listOf("? instalar o htop", "? quanto espaço sobrou", "? achar arquivo relatorio", "? compactar pasta fotos", "? qual meu ip")) {
                out.add(" " + esc() + "[33m" + clip(ex, w - 1) + esc() + "[0m")
            }
            return out
        }
        var best = recipeHits.get(0)
        out.add(" " + esc() + "[1;32mRECEITA" + esc() + "[0m " + clip(best.recipe.name, w - 9))
        out.add("")
        for (var t in wrapText(best.command, w - 1)) {
            out.add(" " + esc() + "[33m" + t + esc() + "[0m")
        }
        out.add("")
        for (var t in wrapText(best.explain, w - 1)) {
            out.add(" " + t)
        }
        if (best.command.contains("<")) {
            out.add("")
            for (var t in wrapText("Troque o que está entre < > depois de apertar TAB.", w - 1)) {
                out.add(" " + esc() + "[90m" + t + esc() + "[0m")
            }
        }
        if (recipeHits.size > 1) {
            out.add("")
            out.add(" " + esc() + "[1;36mOUTRAS RECEITAS" + esc() + "[0m")
            var i = 1
            while (i < recipeHits.size) {
                var m = recipeHits.get(i)
                out.add(" " + clip(m.recipe.name, w - 1))
                out.add("   " + esc() + "[90m" + clip(m.command, w - 3) + esc() + "[0m")
                i = i + 1
            }
        }
        out.add("")
        for (var t in wrapText("TAB coloca o comando na linha; Enter de novo roda. Depois, esta coluna explica cada parte.", w - 1)) {
            out.add(" " + esc() + "[90m" + t + esc() + "[0m")
        }
        return out
    }

    // ---------- indice na lateral ----------

    // A coluna do indice so muda quando a linha digitada muda; com um programa rodando ela
    // fica parada e nada e redesenhado.
    panelDraw() {
        if (editing) {
            panelContent = panelLines(panelWidth() - 1)
        }
        var r = 0
        while (r < rows) {
            var text = NOTEXT
            if (r < panelContent.size) {
                text = panelContent.get(r)
            }
            if (text != lastPanel.get(r)) {
                emit(cupPanel.get(r))
                emit(sep)
                emit(text)
                emit(sgrReset)
                emit(eraseEol)
                lastPanel.set(r, text)
            }
            r = r + 1
        }
    }

    // Linhas do indice para a linha digitada, cada uma com no maximo `w` colunas visiveis.
    Boolean isInstalled(String name) {
        if (name != installedName) {
            installedName = name
            installedOk = commandInstalled(name)
        }
        return installedOk
    }

    // "Falta um programa": o que falta e o comando que instala, para quem esta aprendendo.
    missingLines(List<String> out, String name, String install, Int w) {
        out.add("")
        out.add(" " + esc() + "[1;33m⚠ " + clip(name + " não está instalado", w - 3) + esc() + "[0m")
        if (install.length() > 0) {
            for (var t in wrapText("Para baixar o que falta, use:", w - 1)) {
                out.add(" " + t)
            }
            out.add(" " + esc() + "[33m» " + clip(install, w - 3) + esc() + "[0m")
            var how = "O apt baixa do repositório oficial da sua distribuição e pede a sua senha (sudo). Depois, rode o comando de novo."
            if (recipes.asRoot) {
                how = "O apt baixa do repositório oficial da sua distribuição; como root, não pede senha. Depois, rode o comando de novo."
            }
            for (var t in wrapText(how, w - 1)) {
                out.add(" " + esc() + "[90m" + t + esc() + "[0m")
            }
        } else {
            for (var t in wrapText("Rode o comando: se o sistema souber o pacote, o KofTerm sugere como instalar. Ou procure com apt search " + name + ".", w - 1)) {
                out.add(" " + esc() + "[90m" + t + esc() + "[0m")
            }
        }
    }

    // O comando que instala o pacote, sem sudo para quem ja e root.
    String installCommand(String pkg) {
        if (recipes.asRoot) {
            return "apt install " + pkg
        }
        return "sudo apt install " + pkg
    }

    List<String> panelLines(Int w) {
        if (searching) {
            return searchPanel(w)
        }
        if (picking) {
            return pickPanel(w)
        }
        if (recipeMode()) {
            return recipePanel(w)
        }
        var out = listOf<String>()
        out.add(esc() + "[7m" + pad(clip(" Índice · F2 fecha · F1 busca", w), w) + esc() + "[0m")
        if (notice.length() > 0) {
            out.add("")
            for (var t in wrapText(notice, w - 1)) {
                out.add(" " + esc() + "[1;33m" + t + esc() + "[0m")
            }
        }
        // linha vazia depois de "comando nao encontrado": o cinza ja e o comando que instala
        var hint = ""
        if (ed.line.trim().length() == 0) {
            hint = brain.installHint()
            if (hint.length() == 0 && brain.lastStatus == 127 && ghost.contains("apt install ")) {
                hint = ghost.trim() // o pacote que o proprio sistema indicou
            }
        }
        if (hint.length() > 0) {
            missingLines(out, commandName(brain.lastCmd.trim()), hint, w)
            out.add("")
            for (var t in wrapText("TAB coloca o comando na linha; nada roda sem o seu Enter.", w - 1)) {
                out.add(" " + esc() + "[90m" + t + esc() + "[0m")
            }
            return out
        }
        // "EXIT" nao encontrado e o cinza sugere "exit": explica a diferenca entre maiusculas e minusculas
        if (ed.line.trim().length() == 0 && brain.lastStatus == 127) {
            var typed = commandName(brain.lastCmd.trim())
            var lower = typed.toLowerCase()
            if (typed != lower && commandName(ghost.trim()) == lower) {
                out.add("")
                for (var t in wrapText("Maiúsculas importam: para o Linux, " + typed + " e " + lower + " são nomes diferentes, e os comandos quase sempre são em minúsculas. O Caps Lock está ligado?", w - 1)) {
                    out.add(" " + esc() + "[1;33m" + t + esc() + "[0m")
                }
                out.add("")
                for (var t in wrapText("TAB coloca " + lower + " na linha; nada roda sem o seu Enter.", w - 1)) {
                    out.add(" " + esc() + "[90m" + t + esc() + "[0m")
                }
                return out
            }
        }
        // risco pelo contexto (todos os comandos da linha, sudo/root e a pasta atual), com o motivo
        var risk = lineRisk(ed.line, recipes.asRoot, cwd)
        if (risk.level == RiskLevel.DANGER) {
            out.add("")
            for (var t in wrapText("⚠ PERIGO: este comando " + risk.reason + " O KofTerm nunca sugere isso.", w - 1)) {
                out.add(" " + esc() + "[1;31m" + t + esc() + "[0m")
            }
        } else if (risk.level == RiskLevel.CAUTION) {
            out.add("")
            for (var t in wrapText("⚠ Atenção: este comando " + risk.reason, w - 1)) {
                out.add(" " + esc() + "[1;33m" + t + esc() + "[0m")
            }
        }
        var entries = tab.index.entriesForLine(ed.line)
        if (entries.size == 0) {
            out.add("")
            if (ed.line.trim().length() == 0) {
                for (var t in wrapText("Comece a digitar um comando: aqui aparece o que ele faz e o que cada opção significa.", w - 1)) {
                    out.add(" " + esc() + "[90m" + t + esc() + "[0m")
                }
                out.add("")
                out.add(" " + esc() + "[1;36mO QUE DÁ PARA FAZER" + esc() + "[0m")
                out.add(" " + esc() + "[33mTAB" + esc() + "[0m  aceita o texto em cinza")
                out.add(" " + esc() + "[33m↑ ↓" + esc() + "[0m  comandos anteriores")
                out.add(" " + esc() + "[33mCtrl+R" + esc() + "[0m busca no histórico")
                out.add(" " + esc() + "[33mroda" + esc() + "[0m saída antiga (F3 liga/desliga)")
                out.add(" " + esc() + "[33mF1" + esc() + "[0m   busca no índice")
                out.add(" " + esc() + "[33mF2" + esc() + "[0m   mostra/esconde esta coluna")
                out.add(" " + esc() + "[33m?" + esc() + "[0m    peça do seu jeito:")
                for (var ex in listOf("? instalar o htop", "? quanto espaço sobrou", "? achar arquivo relatorio", "? qual meu ip", "? acessar root")) {
                    out.add("      " + esc() + "[90m" + clip(ex, w - 7) + esc() + "[0m")
                }
                out.add("")
                for (var t in wrapText("Experimente: digite ls -la e veja cada opção explicada aqui.", w - 1)) {
                    out.add(" " + esc() + "[90m" + t + esc() + "[0m")
                }
            } else {
                var words = commandWords(ed.line)
                var name = ""
                if (words.size > 0) {
                    name = words.get(0)
                }
                for (var t in wrapText("O índice ainda não tem \"" + name + "\". F1 abre a busca; man " + name + " abre o manual.", w - 1)) {
                    out.add(" " + esc() + "[90m" + t + esc() + "[0m")
                }
                if (isProgramName(name) && !isInstalled(name)) {
                    missingLines(out, name, "", w)
                }
            }
            return out
        }
        var entry = entries.get(0)
        out.add("")
        out.add(" " + esc() + "[1m" + clip(entry.name, w - 1) + esc() + "[0m")
        for (var t in wrapText(entry.summary, w - 1)) {
            out.add(" " + t)
        }
        // "ip a", "apt install": o programa e a primeira palavra
        var prog = before(entry.name, " ")
        var pkg = tab.index.packageFor(prog)
        if (pkg.length() > 0 && !isInstalled(prog)) {
            missingLines(out, prog, installCommand(pkg), w)
        }
        var used = tab.index.optionsInLine(entry, ed.line)
        if (used.size > 0) {
            out.add("")
            out.add(" " + esc() + "[1;32mNA SUA LINHA" + esc() + "[0m")
            panelOptions(out, used, w)
        }
        // o resto da linha (sudo -i, /etc/passwd...) vem logo, antes da lista completa de opcoes
        if (entries.size > 1) {
            out.add("")
            out.add(" " + esc() + "[1;32mTAMBÉM NA LINHA" + esc() + "[0m")
            var k = 1
            while (k < entries.size) {
                var other = entries.get(k)
                out.add(" " + esc() + "[1m" + clip(other.name, w - 1) + esc() + "[0m")
                for (var t in wrapText(other.summary, w - 3)) {
                    out.add("   " + t)
                }
                var oUsed = tab.index.optionsInLine(other, ed.line)
                if (oUsed.size > 0) {
                    panelOptions(out, oUsed, w)
                }
                k = k + 1
            }
        }
        var others = listOf<Opt>()
        for (var o in entry.options) {
            var isUsed = false
            for (var u in used) {
                if (u.names == o.names) {
                    isUsed = true
                }
            }
            if (!isUsed) {
                others.add(o)
            }
        }
        if (others.size > 0) {
            out.add("")
            out.add(" " + esc() + "[1;36mOPÇÕES" + esc() + "[0m")
            panelOptions(out, others, w)
        }
        if (entry.examples.size > 0) {
            out.add("")
            out.add(" " + esc() + "[1;36mEXEMPLOS" + esc() + "[0m")
            for (var x in entry.examples) {
                out.add(" " + esc() + "[33m" + clip(x.cmd, w - 1) + esc() + "[0m")
                for (var t in wrapText(x.text, w - 3)) {
                    out.add("   " + t)
                }
            }
        }
        if (entry.links.size > 0) {
            out.add("")
            out.add(" " + esc() + "[1;36mLEIA MAIS" + esc() + "[0m")
            for (var l in entry.links) {
                out.add(" " + esc() + "[90m" + clip(l, w - 1) + esc() + "[0m")
            }
        }
        return out
    }

    panelOptions(List<String> out, List<Opt> opts, Int w) {
        var nameW = 8
        for (var o in opts) {
            var first = true
            if (o.names.length() > nameW) {
                // nome longo (-a, --all): numa linha propria, explicacao embaixo
                out.add(" " + esc() + "[33m" + clip(o.names, w - 1) + esc() + "[0m")
                first = false
            }
            for (var t in wrapText(o.text, w - nameW - 3)) {
                if (first) {
                    out.add(" " + esc() + "[33m" + pad(o.names, nameW) + esc() + "[0m " + t)
                    first = false
                } else {
                    out.add(" " + pad("", nameW) + " " + t)
                }
            }
        }
    }

    // ---------- aba do indice (F1) ----------

    openTab() {
        if (mouseCaptured) {
            // a aba do indice nao usa a roda: o mouse volta para o terminal
            mouseCaptured = false
            print(esc() + "[?1000l" + esc() + "[?1006l")
        }
        tab.show(ed.line, rows, cols)
    }

    closeTab() {
        print(esc() + "[2J")
        resetCaches()
        render()
    }

    // ---------- envio ao bash ----------

    sendText(String s) {
        var p = strdup(s)
        writeAll(master, p, strlen(p))
        free(p)
    }

    sendByte(Int b) {
        var p = malloc(1L)
        buffer.poke8(p, b)
        writeAll(master, p, 1L)
        free(p)
    }

    // Enter: a linha vai para o bash. O eco do terminal do bash a escreve no emulador,
    // na mesma posicao em que ela estava desenhada.
    submit() {
        var line = ed.line
        editing = false
        ed.clear()
        // senha, token ou linha começando com espaço: vai para o bash, mas não fica gravada
        if (!privateLine(line) && hist.add(line)) {
            appendLine(histPath, line)
        }
        hist.resetBrowse()
        brain.commandSent(line, feats)
        render()
        sendText(line + "\r")
    }

    acceptGhost() {
        ed.insert(ghost)
    }

    // Ao sair: devolve a tela de antes e desliga os modos que os programas ligaram.
    shutdown() {
        print(esc() + "[0m" + esc() + "[?25h" + esc() + "[?1l" + esc() + ">" + esc() + "[?2004l" +
            esc() + "[?1000l" + esc() + "[?1002l" + esc() + "[?1003l" + esc() + "[?1006l" + esc() + "[?1049l")
    }

    // ---------- teclas ----------

    onKey(Key k) {
        if (k.kind == K.CPR) {
            return // resposta antiga de posicao do cursor: o emulador ja sabe onde esta
        }
        if (!editing) {
            forwardKey(k)
            return
        }
        if (tab.open) {
            if (!tab.onKey(k)) {
                closeTab()
            }
            return
        }
        var kind = k.kind
        if (kind == K.IGNORE) {
            return // clique do mouse e afins: nada muda
        }
        notice = ""
        // saida antiga: roda e Shift+PgUp/PgDn rolam; qualquer outra tecla volta ao fim
        if (kind == K.WHEEL_UP || kind == K.WHEEL_DOWN || kind == K.SHIFT_PAGE_UP || kind == K.SHIFT_PAGE_DOWN) {
            var step = 3
            if (kind == K.SHIFT_PAGE_UP || kind == K.SHIFT_PAGE_DOWN) {
                step = maxZero(rows / 2 - 1) + 1
            }
            if (kind == K.WHEEL_DOWN || kind == K.SHIFT_PAGE_DOWN) {
                step = 0 - step
            }
            scrollView(step)
            needRender = true
            return
        }
        if (view > 0) {
            leaveView()
            if (kind == K.ESC) {
                needRender = true
                return
            }
        }
        if (kind == K.F3) {
            toggleMouse()
            needRender = true
            return
        }
        if (searching && searchKey(kind)) {
            needRender = true
            return
        }
        if (picking && pickKey(kind)) {
            needRender = true
            return
        }
        if (kind == K.CTRL_R) {
            startSearch()
            needRender = true
            return
        }
        if (kind == K.F1 || kind == K.CTRL_T) {
            openTab()
            return
        } else if (kind == K.F2) {
            togglePanel()
        } else if (kind == K.CHAR) {
            ed.insert(codepointToString(k.code))
            hist.resetBrowse()
        } else if (recipeMode() && (kind == K.ENTER || kind == K.TAB || kind == K.RIGHT && ed.atEnd())) {
            acceptRecipe()
        } else if (kind == K.ENTER) {
            submit()
            return
        } else if (kind == K.TAB) {
            if (ghost.length() > 0) {
                acceptGhost()
            } else {
                startPick() // varios arquivos possiveis: a lista para escolher
            }
        } else if (kind == K.RIGHT) {
            if (ed.atEnd() && ghost.length() > 0) {
                acceptGhost()
            } else {
                ed.right()
            }
        } else if (kind == K.WORD_RIGHT) {
            if (ed.atEnd() && ghost.length() > 0 && !recipeMode()) {
                ed.insert(firstWord(ghost))
            } else {
                ed.wordRight()
            }
        } else if (kind == K.LEFT) {
            ed.left()
        } else if (kind == K.WORD_LEFT) {
            ed.wordLeft()
        } else if (kind == K.HOME) {
            ed.home()
        } else if (kind == K.END) {
            ed.end()
        } else if (kind == K.BACKSPACE) {
            ed.backspace()
            hist.resetBrowse()
        } else if (kind == K.DELETE) {
            ed.deleteForward()
        } else if (kind == K.CTRL_U) {
            ed.killToStart()
        } else if (kind == K.CTRL_W) {
            ed.killWordBack()
        } else if (kind == K.CTRL_K) {
            ed.killToEnd()
        } else if (kind == K.UP) {
            ed.set(hist.prev(ed.line))
        } else if (kind == K.DOWN) {
            ed.set(hist.next(ed.line))
        } else if (kind == K.CTRL_C) {
            // o que foi cancelado fica na tela (sem sugestao) e o bash trata o ^C
            var line = ed.line
            editing = false
            ed.clear()
            hist.resetBrowse()
            vt.putText(line)
            render()
            sendByte(3)
            return
        } else if (kind == K.CTRL_D) {
            if (ed.line.length() == 0) {
                editing = false
                render()
                sendByte(4)
                return
            }
            ed.deleteForward()
        } else if (kind == K.CTRL_L) {
            // limpa a tela e pede um prompt novo com uma linha vazia (nao muda o $?).
            // O rascunho volta quando o prompt chegar.
            draftAfterClear = ed.line
            editing = false
            ed.clear()
            vt.clearScreen()
            vt.cx = 0
            vt.cy = 0
            render()
            sendText("\r")
            return
        }
        // desenha uma vez depois de todas as teclas que chegaram juntas (flushRender)
        needRender = true
    }

    Boolean needRender = false

    // Teclas com a busca do Ctrl+R aberta. Devolve false para as que editam a busca (letras,
    // apagar...), que seguem o caminho normal do editor.
    Boolean searchKey(Int kind) {
        if (kind == K.CTRL_R || kind == K.DOWN) {
            if (searchSel < searchHits.size - 1) {
                searchSel = searchSel + 1 // mais antigo
            }
            return true
        }
        if (kind == K.UP) {
            if (searchSel > 0) {
                searchSel = searchSel - 1
            }
            return true
        }
        if (kind == K.ENTER || kind == K.TAB || kind == K.RIGHT) {
            endSearch(searchHits.size > 0)
            return true
        }
        if (kind == K.ESC || kind == K.CTRL_C || kind == K.CTRL_G) {
            endSearch(false)
            return true
        }
        if (kind == K.F1 || kind == K.CTRL_T || kind == K.F2 || kind == K.CTRL_D || kind == K.CTRL_L) {
            endSearch(false)
            return false
        }
        searchSel = 0 // a busca mudou: volta para o mais recente
        return false
    }

    // Teclas com a lista do TAB TAB aberta. Outras teclas fecham a lista e seguem normais.
    Boolean pickKey(Int kind) {
        if (kind == K.TAB || kind == K.DOWN) {
            pickSel = (pickSel + 1) % pickList.size
            return true
        }
        if (kind == K.UP) {
            pickSel = (pickSel + pickList.size - 1) % pickList.size
            return true
        }
        if (kind == K.ENTER || kind == K.RIGHT) {
            var chosen = pickList.get(pickSel)
            ed.insert(chosen.substring(pickBase.length(), chosen.length())) // na linha, sem rodar
            picking = false
            return true
        }
        picking = false
        if (kind == K.ESC || kind == K.CTRL_G) {
            return true
        }
        return false
    }

    flushRender() {
        if (needRender && editing && !tab.open) {
            render()
        }
        needRender = false
    }

    // Fora do prompt (ou depois de um Enter no meio de um colar): a tecla vira bytes de novo.
    forwardKey(Key k) {
        if (k.kind == K.CHAR) {
            sendText(codepointToString(k.code))
        } else if (k.kind == K.ENTER) {
            sendText("\r")
        } else if (k.kind == K.TAB) {
            sendByte(9)
        } else if (k.kind == K.BACKSPACE) {
            sendByte(127)
        } else if (k.kind == K.CTRL_C) {
            sendByte(3)
        } else if (k.kind == K.CTRL_D) {
            sendByte(4)
        } else if (k.kind == K.ESC) {
            sendByte(27)
        } else if (k.kind == K.CTRL_R) {
            sendByte(18)
        } else if (k.kind == K.CTRL_G) {
            sendByte(7)
        }
    }
}
