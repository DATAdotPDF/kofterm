// Arquivos do kofterm em ~/.local/share/kofterm (pasta 0700, arquivos 0600)
// e conversoes entre bytes crus e String.

// Cria ~/.local/share/kofterm se faltar e devolve o caminho.
String dataDir() {
    var home = getenv("HOME")
    mkdir(home + "/.local", Sys.MODE_755)
    mkdir(home + "/.local/share", Sys.MODE_755)
    var dir = home + "/.local/share/kofterm"
    mkdir(dir, Sys.MODE_700)
    // o modo do mkdir/open so vale na criacao: garante 0700 mesmo se a pasta ja existia
    chmod(dir, Sys.MODE_700)
    return dir
}

saveFile(String path, String content) {
    var fd = open(path, Sys.O_WRITE_TRUNC, Sys.MODE_600)
    if (fd < 0) {
        return
    }
    var p = strdup(content)
    writeAll(fd, p, strlen(p))
    free(p)
    close(fd)
    chmod(path, Sys.MODE_600)
}

appendLine(String path, String line) {
    var fd = open(path, Sys.O_WRITE_APPEND, Sys.MODE_600)
    if (fd < 0) {
        return
    }
    var p = strdup(line + "\n")
    writeAll(fd, p, strlen(p))
    free(p)
    close(fd)
    chmod(path, Sys.MODE_600)
}

// Le o arquivo inteiro e devolve as linhas (sem o \n). Arquivo ausente -> lista vazia.
List<String> loadLines(String path) {
    var lines = listOf<String>()
    var fd = open(path, Sys.O_RDONLY, 0)
    if (fd < 0) {
        return lines
    }
    var size = lseek(fd, 0L, Sys.SEEK_END)
    lseek(fd, 0L, Sys.SEEK_SET)
    if (size > 0L) {
        var buf = malloc(size)
        var got = 0L
        while (got < size) {
            var n = read(fd, buf + got, size - got)
            if (n <= 0L) {
                size = got
            } else {
                got = got + n
            }
        }
        var start = 0L
        var i = 0L
        while (i < got) {
            if (buffer.peek8(buf + i) == 10) {
                if (i > start) {
                    lines.add(strndup(buf + start, i - start))
                }
                start = i + 1L
            }
            i = i + 1L
        }
        if (got > start) {
            lines.add(strndup(buf + start, got - start))
        }
        free(buf)
    }
    close(fd)
    return lines
}

String bytesToString(List<Int> bytes) {
    var n = bytes.size
    var p = malloc((n + 1) as Long)
    var i = 0
    while (i < n) {
        buffer.poke8(p + i, bytes.get(i))
        i = i + 1
    }
    var s = strndup(p, n as Long)
    free(p)
    return s
}

// Le um anel de bytes (`len` bytes terminando em `pos`) como String, em ordem.
String ringToString(Long ring, Long size, Long pos, Long len) {
    if (len <= 0L) {
        return ""
    }
    var tmp = malloc(len + 1L)
    var start = (pos - len + size) % size
    var i = 0L
    while (i < len) {
        buffer.poke8(tmp + i, buffer.peek8(ring + (start + i) % size))
        i = i + 1L
    }
    var s = strndup(tmp, len)
    free(tmp)
    return s
}

// Codepoint Unicode -> String (UTF-8 de 1 a 4 bytes).
String codepointToString(Int cp) {
    var b = listOf<Int>()
    if (cp < 128) {
        b.add(cp)
    } else if (cp < 2048) {
        b.add(192 + cp / 64)
        b.add(128 + cp % 64)
    } else if (cp < 65536) {
        b.add(224 + cp / 4096)
        b.add(128 + (cp / 64) % 64)
        b.add(128 + cp % 64)
    } else {
        b.add(240 + cp / 262144)
        b.add(128 + (cp / 4096) % 64)
        b.add(128 + (cp / 64) % 64)
        b.add(128 + cp % 64)
    }
    return bytesToString(b)
}

// Pasta onde esta o executavel (via /proc/self/exe).
String exeDir() {
    var buf = malloc(4096L)
    var n = readlink("/proc/self/exe", buf, 4095L)
    var path = ""
    if (n > 0L) {
        path = strndup(buf, n)
    }
    free(buf)
    var cut = path.length()
    while (cut > 0 && path.substring(cut - 1, cut) != "/") {
        cut = cut - 1
    }
    if (cut <= 1) {
        return "/"
    }
    return path.substring(0, cut - 1)
}

// Onde estao os arquivos que acompanham o binario (index/, corpus/, datasets/):
// - instalado ou release: ao lado do binario (~/.local/share/kofterm/kofterm);
// - compilado no repositorio: <repo>/build/kofterm/Default/Main -> tres pastas acima.
String sourceRoot() {
    var dir = exeDir()
    if (access(dir + "/index/pt_BR.txt", 0) == 0) {
        return dir
    }
    return dir + "/../../.."
}

// O programa `name` existe em alguma pasta do PATH (mais /usr/sbin e /sbin, onde ficam
// ferramentas de rede e de administracao)?
Boolean commandInstalled(String name) {
    for (var dir in splitOn(getenv("PATH") + ":/usr/sbin:/sbin:/usr/bin:/bin", ":")) {
        if (dir.length() > 0 && access(dir + "/" + name, 1) == 0) {
            return true
        }
    }
    return false
}

// 24 caracteres hexadecimais de /dev/urandom: o token do marcador de prompt desta sessao.
String randomToken() {
    var hex = "0123456789abcdef"
    var out = ""
    var fd = open("/dev/urandom", Sys.O_RDONLY, 0)
    var buf = malloc(12L)
    if (fd >= 0 && read(fd, buf, 12L) == 12L) {
        var i = 0L
        while (i < 12L) {
            var b = buffer.peek8(buf + i)
            out = out + hex.substring(b / 16, b / 16 + 1) + hex.substring(b % 16, b % 16 + 1)
            i = i + 1L
        }
    }
    free(buf)
    if (fd >= 0) {
        close(fd)
    }
    return out
}

// Um arquivo compartilhado: o que acompanha o binario em uso, ou o instalado.
String findShared(String dataDirPath, String rel) {
    var near = sourceRoot() + "/" + rel
    if (access(near, 0) == 0) {
        return near
    }
    return dataDirPath + "/" + rel
}

// O indice no idioma escolhido; sem o arquivo em ingles (instalacao antiga), o portugues.
String indexPath(String dataDirPath) {
    var p = findShared(dataDirPath, indexFileName())
    if (access(p, 0) != 0) {
        return findShared(dataDirPath, "index/pt_BR.txt")
    }
    return p
}

// As receitas do ? no idioma escolhido; sem recipes/en.txt (instalacao antiga), o portugues.
String recipesPath(String dataDirPath) {
    if (Lang.en) {
        var p = findShared(dataDirPath, "recipes/en.txt")
        if (access(p, 0) == 0) {
            return p
        }
    }
    return findShared(dataDirPath, "recipes/pt_BR.txt")
}

// Arquivos de uma pasta que terminam com `suffix` (caminhos completos).
List<String> listFiles(String dir, String suffix) {
    var out = listOf<String>()
    var d = opendir(dir)
    if (d == 0L) {
        return out
    }
    var ent = readdir(d)
    while (ent != 0L) {
        var name = strndup(ent + 19L, strlen(ent + 19L))
        if (name.endsWith(suffix) && buffer.peek8(ent + 18L) != 4) {
            out.add(dir + "/" + name)
        }
        ent = readdir(d)
    }
    closedir(d)
    return out
}

// Copia um arquivo byte a byte e aplica o modo (0644, 0755...).
Boolean copyFile(String from, String to, Int mode) {
    var src = open(from, Sys.O_RDONLY, 0)
    if (src < 0) {
        return false
    }
    unlink(to)
    var dst = open(to, Sys.O_WRITE_TRUNC, mode)
    if (dst < 0) {
        close(src)
        return false
    }
    var buf = malloc(65536L)
    var n = read(src, buf, 65536L)
    while (n > 0L) {
        writeAll(dst, buf, n)
        n = read(src, buf, 65536L)
    }
    free(buf)
    close(src)
    close(dst)
    chmod(to, mode)
    return true
}

// Argumentos da linha de comando, lidos de /proc/self/cmdline (separados por NUL).
List<String> commandArgs() {
    var args = listOf<String>()
    var fd = open("/proc/self/cmdline", Sys.O_RDONLY, 0)
    if (fd < 0) {
        return args
    }
    var buf = malloc(65536L)
    var n = read(fd, buf, 65535L)
    close(fd)
    var start = 0L
    var i = 0L
    while (i < n) {
        if (buffer.peek8(buf + i) == 0) {
            args.add(strndup(buf + start, i - start))
            start = i + 1L
        }
        i = i + 1L
    }
    free(buf)
    return args
}

// bashrc do kofterm: carrega o ~/.bashrc do usuario e poe o marcador invisivel
// (ESC ] 7770 ; token ; status ; uid ; pasta BEL) no fim do prompt; o token desta sessao
// impede que uma saida qualquer imite o marcador (veja prompt.kf). Sem readline (bash --noediting),
// o \[ \] do PS1 nao e necessario.
//
// O gancho se reinstala a cada prompt: o ~/.bashrc do Kali faz
// PROMPT_COMMAND="PROMPT_COMMAND=echo", que se sobrescreve no primeiro prompt e apagaria o
// gancho (o codigo de saida ficava sempre 0). Sem barra invertida: o KOF nao a produz em String.
//
// Shells dentro do shell: `sudo -i` (e su, -s, bash) abre outro bash, que nao carregaria este
// arquivo, e o KofTerm deixaria de ver o prompt. As funcoes sudo e bash abaixo abrem esses
// shells ja com este arquivo; qualquer outro uso de sudo/bash passa direto. A linha digitada
// continua a mesma (a tela mostra "sudo -i").
String shellRc(String dir, Boolean login, String token) {
    var esc = "\u001b"
    var bel = "\u0007"
    var rc = dir + "/bashrc"
    var rcLogin = dir + "/bashrc-login"
    var extra = ""
    if (login) {
        extra = "cd ~\n" // sudo -i comeca na pasta do root
    }
    return "# KofTerm: gerado a cada inicio. Nao edite.\n" +
        "__kofterm_rc='" + rc + "'\n" +
        "__kofterm_login='" + rcLogin + "'\n" +
        "sudo() {\n" +
        "  case \"$*\" in\n" +
        "    -i|su|'su -'|'su root'|'su - root'|'-i bash') command sudo -H bash --noediting --rcfile \"$__kofterm_login\" -i ;;\n" +
        "    -s|bash|'-s bash') command sudo -H bash --noediting --rcfile \"$__kofterm_rc\" -i ;;\n" +
        "    *) command sudo \"$@\" ;;\n" +
        "  esac\n" +
        "}\n" +
        "bash() { if [ $# -eq 0 ]; then command bash --noediting --rcfile \"$__kofterm_rc\" -i; else command bash \"$@\"; fi; }\n" +
        "[ -f ~/.bashrc ] && . ~/.bashrc\n" +
        "__kofterm_mark='" + esc + "]7770;" + token + ";$__kofterm_s;$EUID;$PWD" + bel + "'\n" +
        "__kofterm_pre() { __kofterm_s=$?; }\n" +
        "__kofterm_hook() {\n" +
        "  if [[ \"$(declare -p PROMPT_COMMAND 2>/dev/null)\" == \"declare -a\"* ]]; then\n" +
        "    [[ \"${PROMPT_COMMAND[0]}\" == __kofterm_pre ]] || PROMPT_COMMAND=(__kofterm_pre \"${PROMPT_COMMAND[@]}\" __kofterm_prompt)\n" +
        "  else\n" +
        "    case \"$PROMPT_COMMAND\" in \"__kofterm_pre;\"*) ;; *) PROMPT_COMMAND=\"__kofterm_pre;${PROMPT_COMMAND:+${PROMPT_COMMAND%;};}__kofterm_prompt\" ;; esac\n" +
        "  fi\n" +
        "}\n" +
        "__kofterm_prompt() { [[ \"$PS1\" == *\"$__kofterm_mark\" ]] || PS1=\"$PS1$__kofterm_mark\"; __kofterm_hook; }\n" +
        "__kofterm_hook\n" +
        extra
}
