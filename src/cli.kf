// Subcomandos: kofterm [contribute|check|install|update|uninstall|doctor|selftest|lang|version|help]
// Sem argumentos, abre o terminal (main.kf).

class Version {
    static String NUMBER = "0.8.0"
}

printHelp() {
    println("KofTerm " + Version.NUMBER + " — terminal com autocomplete por IA local, 100% offline")
    println("")
    println("  kofterm                      abre o terminal")
    println("  kofterm contribute --preview mostra o que seria enviado ao projeto (nada e gravado)")
    println("  kofterm contribute           grava kofterm-contrib.kofdata na pasta atual")
    println("  kofterm check ARQUIVO...     valida arquivos .kofdata (usado no CI)")
    println("  kofterm install              instala em ~/.local/share/kofterm e cria ~/.local/bin/kofterm")
    println("  kofterm update               mostra como atualizar (nao baixa nada)")
    println("  kofterm uninstall            remove o programa (seu historico fica, a menos que use --purge)")
    println("  kofterm doctor               confere a instalacao e mostra onde ficam seus dados")
    println("  kofterm selftest             testa o terminal: sinais, saidas grandes, marcador e historico")
    println("  kofterm lang [pt|en]         idioma das telas e do indice (portugues e o padrao)")
    println("  kofterm version              mostra a versao")
    println("")
    println("Dentro do terminal: TAB aceita a sugestao, F2 mostra o indice na lateral, F1 busca no indice,")
    println("e '? o que voce quer fazer' (ex.: ? instalar o htop) sugere o comando.")
}

// O anonimizador conhece: a lista publica de comandos, os nomes do indice e as palavras
// simples do corpus. Mais nada.
Anonymizer buildAnonymizer(String dir) {
    var a = Anonymizer()
    for (var w in loadLines(findShared(dir, "corpus/commands.txt"))) {
        a.addVocab(w)
    }
    var idx = CommandIndex()
    idx.load(loadLines(findShared(dir, "index/pt_BR.txt")))
    for (var e in idx.entries) {
        for (var w in anonSplit(e.name, " ")) {
            if (anonPlain(w) && !w.startsWith("-")) {
                a.addVocab(w)
            }
        }
    }
    for (var line in loadLines(findShared(dir, "corpus/sessions.txt"))) {
        if (!line.startsWith(";") && !line.startsWith("@")) {
            for (var w in anonSplit(line, " ")) {
                if (anonPlain(w) && !w.startsWith("-") && !anonDigits(w)) {
                    a.addVocab(w)
                }
            }
        }
    }
    return a
}

Int runContribute(List<String> args) {
    var preview = false
    for (var a in args) {
        if (a == "--preview") {
            preview = true
        }
    }
    var dir = dataDir()
    var anon = buildAnonymizer(dir)
    var b = ContribBuilder()
    var prev = ""
    var used = 0
    for (var raw in loadLines(dir + "/events")) {
        var parts = splitOn(raw, "\u0009")
        if (parts.size >= 3 && parts.get(0) != "127") {
            var line = anon.line(parts.get(2))
            var cmd = ""
            var toks = anonSplit(line, " ")
            if (toks.size > 0) {
                cmd = toks.get(0)
                if (cmd == "sudo" && toks.size > 1) {
                    cmd = toks.get(1)
                }
            }
            b.add(prev, line, parts.get(1), cmd)
            prev = line
            used = used + 1
        }
    }
    var out = b.build(3, Version.NUMBER)
    // confere o proprio resultado com o mesmo validador do CI
    for (var l in out) {
        if (anon.check(l).length() > 0) {
            println("kofterm: linha recusada pelo validador, nada foi gravado: " + l)
            return 1
        }
    }
    if (out.size <= 2) {
        println("Ainda nao ha padroes repetidos pelo menos 3 vezes (" + used + " comandos lidos).")
        println("Continue usando o KofTerm e tente de novo mais tarde.")
        return 0
    }
    if (preview) {
        for (var l in out) {
            println(l)
        }
        println("")
        println("(" + (out.size - 2) + " linhas. Nada foi gravado. Para gravar: kofterm contribute)")
        return 0
    }
    var content = ""
    for (var l in out) {
        content = content + l + "\n"
    }
    saveFile("kofterm-contrib.kofdata", content)
    println("Gravado: kofterm-contrib.kofdata (" + (out.size - 2) + " linhas)")
    println("")
    println("Para contribuir (so se quiser):")
    println("  1. Leia o arquivo inteiro. So deve ter comandos genericos e marcadores como <PATH>.")
    println("  2. Faca um fork de https://github.com/DATAdotPDF/kofterm")
    println("  3. Copie o arquivo para datasets/contrib/<um-apelido>.kofdata")
    println("  4. git add, git commit, git push e abra um Pull Request.")
    println("O KofTerm nunca envia nada sozinho: quem envia e o seu Git, se voce decidir.")
    return 0
}

Int runCheck(List<String> args) {
    var dir = dataDir()
    var anon = buildAnonymizer(dir)
    var bad = 0
    var files = 0
    var i = 2
    while (i < args.size) {
        var path = args.get(i)
        files = files + 1
        var n = 0
        for (var l in loadLines(path)) {
            n = n + 1
            var why = anon.check(l)
            if (why.length() > 0) {
                println(path + ":" + n + ": " + why)
                bad = bad + 1
            }
        }
        i = i + 1
    }
    if (files == 0) {
        println("uso: kofterm check ARQUIVO.kofdata...")
        return 2
    }
    if (bad > 0) {
        println(bad + " problema(s) encontrado(s)")
        return 1
    }
    println("ok: " + files + " arquivo(s) valido(s)")
    return 0
}

Int runInstall() {
    var dir = dataDir()
    var root = sourceRoot()
    var home = getenv("HOME")
    var ok = copyFile("/proc/self/exe", dir + "/kofterm.new", Sys.MODE_755)
    if (ok) {
        unlink(dir + "/kofterm")
        // rename via copia: o binario em uso pode ser o proprio destino
        ok = copyFile(dir + "/kofterm.new", dir + "/kofterm", Sys.MODE_755)
        unlink(dir + "/kofterm.new")
    }
    if (!ok) {
        println("kofterm: nao consegui copiar o programa para " + dir)
        return 1
    }
    for (var sub in listOf("index", "corpus", "recipes", "datasets", "datasets/contrib")) {
        mkdir(dir + "/" + sub, Sys.MODE_755)
    }
    var copied = 0
    for (var sub in listOf("index", "corpus", "recipes", "datasets/contrib")) {
        for (var f in listFiles(root + "/" + sub, "")) {
            var name = f.substring(f.lastIndexOf("/") + 1, f.length())
            if (!name.startsWith(".") && copyFile(f, dir + "/" + sub + "/" + name, 420)) {
                copied = copied + 1
            }
        }
    }
    mkdir(home + "/.local", Sys.MODE_755)
    mkdir(home + "/.local/bin", Sys.MODE_755)
    unlink(home + "/.local/bin/kofterm")
    symlink(dir + "/kofterm", home + "/.local/bin/kofterm")
    // de onde veio esta instalacao, para o `kofterm update` mostrar o comando certo
    var origin = "release"
    if (access(root + "/.git", 0) == 0) {
        origin = "git " + absolutePath(root)
    }
    saveFile(dir + "/origem", origin + "\n")
    println("KofTerm " + Version.NUMBER + " instalado:")
    println("  programa: " + dir + "/kofterm (" + copied + " arquivos de indice e corpus)")
    println("  comando:  " + home + "/.local/bin/kofterm")
    println("")
    println("Abra com: kofterm")
    println("Se o comando nao for encontrado, adicione ao ~/.bashrc:  export PATH=\"$HOME/.local/bin:$PATH\"")
    return 0
}

Int runUninstall(List<String> args) {
    var purge = false
    for (var a in args) {
        if (a == "--purge") {
            purge = true
        }
    }
    var dir = dataDir()
    var home = getenv("HOME")
    unlink(home + "/.local/bin/kofterm")
    unlink(dir + "/kofterm")
    unlink(dir + "/bashrc")
    unlink(dir + "/bashrc-login")
    unlink(dir + "/origem")
    for (var sub in listOf("index", "corpus", "recipes", "datasets/contrib")) {
        for (var f in listFiles(dir + "/" + sub, "")) {
            unlink(f)
        }
        rmdir(dir + "/" + sub)
    }
    rmdir(dir + "/datasets")
    if (purge) {
        for (var f in listOf("history", "events", "panel", "mouse", "lang")) {
            unlink(dir + "/" + f)
        }
        rmdir(dir)
        println("KofTerm removido, junto com historico e aprendizado.")
    } else {
        println("KofTerm removido. Seu historico e o que o modelo aprendeu ficaram em " + dir)
        println("Para apagar tambem: kofterm uninstall --purge (rode antes de remover) ou rm -r " + dir)
    }
    return 0
}

// Dentro de uma janela do KofTerm, KOFTERM guarda a versao dela. Se o instalado e outro, a
// janela continua na versao antiga ate ser reaberta: avisa. "" quando esta tudo certo.
String windowVersionNote() {
    var p = secure_getenv("KOFTERM")
    if (p == 0L) {
        return ""
    }
    var v = strndup(p, strlen(p))
    if (v == Version.NUMBER) {
        return ""
    }
    var win = "uma versão anterior à 0.7.2"
    if (v != "1") {
        win = "o KofTerm " + v
    }
    return "Atenção: esta janela está com " + win + ", e o instalado é o " + Version.NUMBER + ".\n" +
        "Digite exit e abra o kofterm de novo para usar a versão instalada."
}

// Caminho absoluto e sem "..", ou o proprio caminho se nao existir.
String absolutePath(String path) {
    var p = realpath(path, 0L)
    if (p == 0L) {
        return path
    }
    var out = strndup(p, strlen(p))
    free(p)
    return out
}

// So mostra o comando de atualizacao: o KofTerm nao acessa a internet e nao roda nada sozinho.
Int runUpdate() {
    var dir = dataDir()
    var home = getenv("HOME")
    var releases = "https://github.com/DATAdotPDF/kofterm/releases"
    println("KofTerm " + Version.NUMBER + " instalado.")
    println("")
    var origin = ""
    var lines = loadLines(dir + "/origem")
    if (lines.size > 0) {
        origin = lines.get(0)
    }
    var repo = ""
    if (origin.startsWith("git ")) {
        repo = origin.substring(4, origin.length())
    } else if (origin.length() == 0 && access(home + "/kofterm/.git", 0) == 0) {
        repo = home + "/kofterm" // instalado por uma versao que ainda nao anotava a origem
    }
    if (repo.length() > 0 && access(repo + "/.git", 0) == 0) {
        println("Você instalou pelo código, em " + repo + ". Para atualizar, rode:")
        println("")
        println("  cd " + repo + " && git pull && ./install.sh")
    } else if (origin == "release") {
        println("Você instalou pela release pronta. Para atualizar:")
        println("")
        println("  1. Baixe o kofterm-X.Y.Z-linux-x86_64.tar.gz novo e o SHA256SUMS de")
        println("     " + releases)
        println("  2. Na pasta onde baixou, rode (troque X.Y.Z pelo número da versão):")
        println("")
        println("  sha256sum -c SHA256SUMS --ignore-missing && tar -xzf kofterm-X.Y.Z-linux-x86_64.tar.gz && ./kofterm-X.Y.Z-linux-x86_64/kofterm install")
    } else {
        println("Não sei de onde veio esta instalação. Use o caso que for o seu:")
        println("")
        println("  Pelo código (dentro da pasta onde você clonou o projeto):")
        println("    git pull && ./install.sh")
        println("")
        println("  Pela release pronta: baixe o .tar.gz novo e o SHA256SUMS de " + releases)
        println("    sha256sum -c SHA256SUMS --ignore-missing && tar -xzf kofterm-X.Y.Z-linux-x86_64.tar.gz && ./kofterm-X.Y.Z-linux-x86_64/kofterm install")
    }
    println("")
    println("Depois, feche e abra de novo as janelas do KofTerm que estavam abertas: cada uma")
    println("continua na versão antiga até ser reaberta.")
    println("Seu histórico e o que o KofTerm aprendeu ficam em " + dir + " e continuam lá.")
    println("O que mudou em cada versão: https://github.com/DATAdotPDF/kofterm/blob/main/CHANGELOG.md")
    println("O KofTerm não acessa a internet: ele só mostrou o comando. Nada foi baixado nem executado.")
    return 0
}

Int runDoctor() {
    var dir = dataDir()
    var exe = exeDir()
    println("KofTerm " + Version.NUMBER)
    println("  programa:   " + exe)
    println("  arquivos:   " + sourceRoot())
    println("  seus dados: " + dir + " (pasta 0700, arquivos 0600)")
    var idx = CommandIndex()
    setLang(loadLines(dir + "/lang"))
    idx.load(loadLines(indexPath(dir)))
    println("  indice:     " + idx.entries.size + " entradas (" + indexFileName() + ")")
    println("  corpus:     " + loadLines(findShared(dir, "corpus/sessions.txt")).size + " linhas")
    println("  contribuicoes da comunidade: " + listFiles(findShared(dir, "datasets/contrib"), ".kofdata").size + " arquivo(s)")
    println("  aprendido com voce: " + loadLines(dir + "/events").size + " comandos, historico com " + loadLines(dir + "/history").size)
    var bashOk = access("/bin/bash", 1) == 0 || access("/usr/bin/bash", 1) == 0
    println("  bash:       " + bashOk)
    println("  terminal:   " + (isatty(0) == 1) + " (entrada e um terminal)")
    println("")
    println("Rede: o KofTerm nao tem codigo de rede. Para conferir voce mesmo:")
    println("  strace -f -e trace=network kofterm")
    println("(nao deve aparecer nenhuma chamada socket/connect do kofterm)")
    return 0
}

// `kofterm lang` mostra o idioma; `kofterm lang en` ou `pt` grava a escolha. Vale para as
// janelas abertas depois (cada janela le o idioma ao abrir).
Int runLang(List<String> args) {
    var dir = dataDir()
    if (args.size < 3) {
        setLang(loadLines(dir + "/lang"))
        println(tr("Idioma: português. Para inglês: kofterm lang en", "Language: English. For Portuguese: kofterm lang pt"))
        return 0
    }
    var want = args.get(2)
    if (want == "en") {
        saveFile(dir + "/lang", "en\n")
        println("KofTerm in English from the next window: type exit and open kofterm again.")
        println("The index and the screens are in English; the ? recipes are still in Portuguese.")
        return 0
    }
    if (want == "pt" || want == "pt_BR") {
        saveFile(dir + "/lang", "pt\n")
        println("KofTerm em português a partir da próxima janela: digite exit e abra o kofterm de novo.")
        return 0
    }
    println("uso: kofterm lang [pt|en]")
    return 2
}

// Executa um subcomando e devolve o codigo de saida, ou -1 se nao houver subcomando.
Int runSubcommand(List<String> args) {
    if (args.size < 2) {
        return -1
    }
    var cmd = args.get(1)
    if (cmd == "contribute") {
        return runContribute(args)
    }
    if (cmd == "check") {
        return runCheck(args)
    }
    if (cmd == "install") {
        return runInstall()
    }
    if (cmd == "update") {
        return runUpdate()
    }
    if (cmd == "uninstall") {
        return runUninstall(args)
    }
    if (cmd == "selftest") {
        return runSelftest()
    }
    if (cmd == "doctor") {
        return runDoctor()
    }
    if (cmd == "lang") {
        return runLang(args)
    }
    if (cmd == "version" || cmd == "--version" || cmd == "-V") {
        println("KofTerm " + Version.NUMBER)
        var note = windowVersionNote()
        if (note.length() > 0) {
            println(note)
        }
        return 0
    }
    printHelp()
    if (cmd == "help" || cmd == "--help" || cmd == "-h") {
        return 0
    }
    return 2
}
